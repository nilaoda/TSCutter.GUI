<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:TSCutter.GUI.Themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ia="using:Avalonia.Xaml.Interactivity"
        xmlns:viewModels="clr-namespace:TSCutter.GUI.ViewModels.Preview"
        xmlns:local="clr-namespace:TSCutter.GUI"
        xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        mc:Ignorable="d"
        x:Class="TSCutter.GUI.Views.Preview.MediainfoWindow"
        x:DataType="viewModels:MediainfoWindowViewModel"
        DataContext="{x:Static local:App.MediainfoDialog}"
        Title="{DynamicResource String.MediaInfo.Title}"
        Width="640"
        Height="480"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanMinimize="False"
        CanResize="True">

    <Interaction.Behaviors>
        <RoutedEventTriggerBehavior RoutedEvent="{x:Static Control.LoadedEvent}">
            <InvokeCommandAction Command="{Binding BuildInfoCommand}" />
        </RoutedEventTriggerBehavior>
    </Interaction.Behaviors>

    <DockPanel Margin="8" LastChildFill="True">

        <!-- 按钮区 -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,6,0,0" Spacing="8">
            <Button Content="{Binding BtnContent}"
                    Width="100"
                    Command="{Binding CopyCommand}" />
            <Button Content="{DynamicResource String.Window.Close}" MinWidth="80" IsCancel="True"
                    Command="{x:Static themes:WindowCommands.Close}" CommandParameter="{Binding $parent[Window]}" />
        </StackPanel>

        <!-- 主显示区 -->
        <TabControl>
            <TabItem Header="{DynamicResource String.MediaInfo.InfoTab}">
                <ClassicBorderDecorator BorderThickness="1" BorderStyle="Etched">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding InfoText}"
                                 FontSize="13"
                                 FontFamily="Consolas, Menlo, Courier New"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="6"
                                 TextWrapping="NoWrap" />
                    </ScrollViewer>
                </ClassicBorderDecorator>
            </TabItem>

            <!-- 章节或读到的全部 EPG 节目：单击章节或录制中的节目跳到它的开始 -->
            <TabItem Header="{Binding SegmentTabHeader}">
                <Panel>
                    <ListBox ItemsSource="{Binding SegmentItems}"
                             Background="Transparent"
                             IsVisible="{Binding HasSegmentItems}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Tapped="SegmentList_OnTapped"
                             KeyDown="SegmentList_OnKeyDown">
                        <ListBox.Styles>
                            <Style Selector="Grid.noJump">
                                <Setter Property="Opacity" Value="0.55" />
                            </Style>
                            <Style Selector="Grid.canJump">
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                            <!-- 日期标题行只作分组，不能选中或获得焦点。 -->
                            <Style Selector="ListBoxItem" x:DataType="viewModels:SegmentListItem">
                                <Setter Property="Focusable" Value="{Binding !IsHeader}" />
                                <Setter Property="IsHitTestVisible" Value="{Binding !IsHeader}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="viewModels:SegmentListItem">
                                <Panel>
                                    <!-- EPG 的日期标题：同一天的节目只在第一行之前写一次日期。 -->
                                    <Grid ColumnDefinitions="Auto,*" Margin="2,6,2,0" IsVisible="{Binding IsHeader}">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                   Foreground="{DynamicResource {x:Static common:SystemColors.GrayTextBrushKey}}" />
                                        <Border Grid.Column="1" Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource {x:Static common:SystemColors.GrayTextBrushKey}}" Opacity="0.4" />
                                    </Grid>
                                    <Grid ColumnDefinitions="96,*,Auto" RowDefinitions="Auto,Auto" Margin="2,3"
                                          IsVisible="{Binding !IsHeader}"
                                          Classes.canJump="{Binding CanJump}"
                                          Classes.noJump="{Binding !CanJump}">
                                        <TextBlock Text="{Binding Time}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Opacity="0.75" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                                   ToolTip.Tip="{Binding Description}"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                   Opacity="0.75" />
                                    </Grid>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{DynamicResource String.Chapter.Empty}"
                               IsVisible="{Binding !HasSegmentItems}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static common:SystemColors.GrayTextBrushKey}}" />
                </Panel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
