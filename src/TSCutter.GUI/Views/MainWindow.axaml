<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TSCutter.GUI.ViewModels"
        xmlns:views="using:TSCutter.GUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ia="using:Avalonia.Xaml.Interactivity"
        xmlns:themes="using:TSCutter.GUI.Themes"
        xmlns:controls="clr-namespace:TSCutter.GUI.Controls"
        xmlns:converters="clr-namespace:TSCutter.GUI.Converters"
        xmlns:local="clr-namespace:TSCutter.GUI"
        xmlns:models="clr-namespace:TSCutter.GUI.Models.Editing"
        xmlns:modelsPreview="clr-namespace:TSCutter.GUI.Models.Preview"
        xmlns:commonControls="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        mc:Ignorable="d"
        Width="1040" Height="740"
        MinWidth="670" MinHeight="400"
        x:Class="TSCutter.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="CutterMainWindow"
        DragDrop.AllowDrop="True"
        Focusable="True"
        Closing="Window_OnClosing"
        Icon="/Assets/logo.ico"
        DataContext="{x:Static local:App.MainWindow}"
        WindowStartupLocation="CenterScreen"
        Title="{Binding WindowTitle}">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type modelsPreview:PreviewAudioTrackOption}" x:DataType="modelsPreview:PreviewAudioTrackOption">
            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayText}" />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <converters:SecondsToStringConverter x:Key="SecondsConverter" />
        <!-- 临时预览状态使用纯文字，解码忙碌时禁用点击也不改变颜色，避免闪烁。 -->
        <ControlTheme x:Key="PreviewStatusTextTheme" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static commonControls:SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <TextBlock x:Name="StatusText" Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                               VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ TextBlock#StatusText">
                <Setter Property="TextDecorations" Value="Underline" />
            </Style>
            <Style Selector="^:focus-visible /template/ TextBlock#StatusText">
                <Setter Property="TextDecorations" Value="Underline" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="ClipExportStatusTheme" TargetType="Button" BasedOn="{StaticResource PreviewStatusTextTheme}">
            <Style Selector="^.export-warning">
                <Setter Property="Foreground" Value="{DynamicResource AppStatusWarningForegroundBrush}" />
            </Style>
            <Style Selector="^.export-error">
                <Setter Property="Foreground" Value="{DynamicResource AppStatusErrorForegroundBrush}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="ClipEditButtonTheme" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static commonControls:SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Path Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeJoin="Round"
                              Data="M 2,9 L 2,12 L 5,12 L 12,5 L 9,2 Z M 7.5,3.5 L 10.5,6.5" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource {x:Static commonControls:SystemColors.ControlLightBrushKey}}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource {x:Static commonControls:SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static commonControls:SystemColors.HighlightTextBrushKey}}" />
            </Style>
            <Style Selector="^:focus-visible">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static commonControls:SystemColors.HighlightBrushKey}}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static commonControls:SystemColors.GrayTextBrushKey}}" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Interaction.Behaviors>
        <RoutedEventTriggerBehavior RoutedEvent="{x:Static Control.LoadedEvent}">
            <InvokeCommandAction Command="{Binding ProcessCommandLineCommand}" />
        </RoutedEventTriggerBehavior>
    </Interaction.Behaviors>
    
    <Window.Styles>
        <Style Selector="ClassicBorderDecorator#DropPanelFrame">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}" />
        </Style>
        <Style Selector="Border#DropPanelTitle">
            <Setter Property="Background" Value="{DynamicResource DropTitleBrush}" />
        </Style>
        <Style Selector="ClassicBorderDecorator#DropPanelContent">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="14,16" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.hyperlink">
            <Setter Property="Template">
                <ControlTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Text="{TemplateBinding Content}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock:pointerover">
                                <Setter Property="TextDecorations" Value="Underline" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector=".video-fullscreen /template/ DockPanel#RootLayout > :is(TemplatedControl)">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=".video-fullscreen /template/ Border#MacOSHeader">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=".video-fullscreen /template/ ClassicBorderDecorator#Bd">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="(themes:DesktopWindowChrome.FrameThickness)" Value="0" />
        </Style>
        <Style Selector=".video-fullscreen /template/ DockPanel#RootLayout">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.fullscreen-action">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip.Placement" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover"><Setter Property="Background" Value="#35FFFFFF" /></Style>
            <Style Selector="^:pressed"><Setter Property="Background" Value="#55FFFFFF" /></Style>
            <Style Selector="^:focus-visible"><Setter Property="Background" Value="#35FFFFFF" /></Style>
            <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
        </Style>
    </Window.Styles>
    
    <!-- Don't know why NativeMenuItem's Gesture only works on macOS, so here add KeyBindings -->
    <Window.KeyBindings>
        <KeyBinding Gesture="{OnPlatform Ctrl+O, macOS=⌘+O}" Command="{Binding LoadVideoClickCommand}"/>
        <KeyBinding Gesture="{OnPlatform Ctrl+S, macOS=⌘+S}" Command="{Binding SaveVideoClickCommand}"/>
        <KeyBinding Gesture="{OnPlatform Ctrl+Z, macOS=⌘+Z}" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="{OnPlatform Ctrl+Y, macOS=⌘+Shift+Z}" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Left" Command="{Binding PrevGopClickCommand}"/>
        <KeyBinding Gesture="Shift+Left" Command="{Binding Prev10GopClickCommand}"/>
        <KeyBinding Gesture="Right" Command="{Binding NextGopClickCommand}"/>
        <KeyBinding Gesture="Shift+Right" Command="{Binding Next10GopClickCommand}"/>
        <KeyBinding Gesture="I" Command="{Binding MarkClipStartShortcutCommand}"/>
        <KeyBinding Gesture="O" Command="{Binding MarkClipEndShortcutCommand}"/>
    </Window.KeyBindings>

    <NativeMenu.Menu>
        <NativeMenu>
        </NativeMenu>
    </NativeMenu.Menu>

    <Grid x:Name="DropSurface" RowDefinitions="Auto, *">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ClipSelectionBackgroundBrush"
                                         Color="{DynamicResource SystemAccentColorLight1}" />
                        <SolidColorBrush x:Key="ClipThumbnailBackgroundBrush" Color="#303236" />
                        <SolidColorBrush x:Key="ClipThumbnailPlaceholderBrush" Color="#D8DADD" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <!-- 选中卡片只做轻微蓝色染色，避免与标题栏、进度条争夺视觉焦点。 -->
                        <SolidColorBrush x:Key="ClipSelectionBackgroundBrush" Color="#2B3B4B" />
                        <SolidColorBrush x:Key="ClipThumbnailBackgroundBrush" Color="#111316" />
                        <SolidColorBrush x:Key="ClipThumbnailPlaceholderBrush" Color="#969DA5" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <LinearGradientBrush x:Key="DropTitleBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="{DynamicResource {x:Static commonControls:SystemColors.ActiveCaptionColorKey}}" Offset="0" />
                    <GradientStop Color="{DynamicResource {x:Static commonControls:SystemColors.GradientActiveCaptionColorKey}}" Offset="1" />
                </LinearGradientBrush>
                <SolidColorBrush x:Key="DropTitleTextBrush"
                                 Color="{DynamicResource {x:Static commonControls:SystemColors.ActiveCaptionTextColorKey}}" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid x:Name="EditingSurface" Grid.RowSpan="2" RowDefinitions="Auto,*">
        <ClassicBorderDecorator x:Name="AppMenuFrame" Grid.Row="0" DockPanel.Dock="Top" Classes="app-section-frame app-menu-frame" BorderStyle="Etched">
            <DockPanel Margin="0, 2">
                <commonControls:RebarHandle />
                <Menu x:Name="AppMenu">
                    <MenuItem Header="{DynamicResource String.Menu.File}">
                        <MenuItem Header="{DynamicResource String.Menu.OpenVideo}"
                                  Command="{Binding LoadVideoClickCommand}"
                                  InputGesture="{OnPlatform Ctrl+O, macOS=⌘+O}" />
                        <MenuItem Header="{DynamicResource String.Disc.OpenFolder}"
                                  Command="{Binding OpenDiscFolderCommand}" />
                        <MenuItem Header="{DynamicResource String.Project.Open}"
                                  Command="{Binding OpenProjectCommand}" />
                        <MenuItem Header="{DynamicResource String.Project.Save}"
                                  Command="{Binding SaveProjectCommand}" />
                        <MenuItem Header="{DynamicResource String.Project.SaveAs}"
                                  Command="{Binding SaveProjectAsCommand}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.SaveClip}"
                                  Command="{Binding SaveVideoClickCommand}"
                                  InputGesture="{OnPlatform Ctrl+S, macOS=⌘+S}" />
                        <MenuItem Header="{DynamicResource String.Menu.KeyFrameOverview}"
                                  Command="{Binding KeyFrameOverviewClickCommand}" />
                        <MenuItem Header="{DynamicResource String.Menu.ThumbnailSheet}"
                                  Command="{Binding ThumbnailSheetClickCommand}" />
                        <MenuItem Header="{DynamicResource String.AddToQueue}"
                                  Command="{Binding AddToQueueCommand}" />
                        <MenuItem Header="{DynamicResource String.MergeClips.Menu}"
                                  Command="{Binding MergeSelectedClipsCommand}" />
                        <MenuItem Header="{DynamicResource String.RemuxExport.Options}"
                                  IsVisible="{Binding IsRemuxExport}" Command="{Binding RemuxExportOptionsCommand}" />
                        <MenuItem Header="{DynamicResource String.Menu.ExportQueue}"
                                  Command="{Binding BatchExportQueueCommand}" />
                        <MenuItem Header="{DynamicResource String.Menu.ExportRecords}"
                                  Command="{Binding ShowExportRecordsCommand}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.CloseVideo}"
                                  Command="{Binding CloseVideoClickCommand}"/>
                        <MenuItem Header="{DynamicResource String.Menu.Exit}"
                                  Command="{Binding ExitApplicationCommand}"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource String.Menu.Edit}">
                        <MenuItem Header="{DynamicResource String.Menu.Undo}"
                                  Command="{Binding UndoCommand}"
                                  InputGesture="{OnPlatform Ctrl+Z, macOS=⌘+Z}" />
                        <MenuItem Header="{DynamicResource String.Menu.Redo}"
                                  Command="{Binding RedoCommand}"
                                  InputGesture="{OnPlatform Ctrl+Y, macOS=⌘+Shift+Z}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource String.Menu.Tools}">
                        <MenuItem Header="{DynamicResource String.FrameSearch.Menu}"
                                  Command="{Binding FrameSearchClickCommand}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.ToolGroupAnalyze}">
                            <MenuItem Header="{DynamicResource String.Menu.TsCheck}">
                                <MenuItem Header="{DynamicResource String.Menu.TsCheck.Single}"
                                          Command="{Binding TsCheckClickCommand}" />
                                <MenuItem Header="{DynamicResource String.Menu.TsCheck.Batch}"
                                          Command="{Binding TsBatchCheckClickCommand}" />
                            </MenuItem>
                            <MenuItem Header="{DynamicResource String.Menu.TsPacketViewer}"
                                      Command="{Binding TsPacketViewerClickCommand}" />
                            <MenuItem x:Name="OpenPlaybackBenchmarkItem" Header="{DynamicResource String.Menu.PlaybackBenchmark}"
                                      Command="{Binding PlaybackBenchmarkClickCommand}" />
                        </MenuItem>
                        <MenuItem Header="{DynamicResource String.Menu.ToolGroupExtract}">
                            <MenuItem Header="{DynamicResource String.Menu.RawCutter}"
                                      Command="{Binding RawCutterClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsFilterPid}"
                                      Command="{Binding TsFilterClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsFilterService}"
                                      Command="{Binding TsServiceFilterClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsEsExtractor}"
                                      Command="{Binding TsEsExtractorClickCommand}" />
                        </MenuItem>
                        <MenuItem Header="{DynamicResource String.Menu.ToolGroupEdit}">
                            <MenuItem Header="{DynamicResource String.Menu.TsRemux}"
                                      Command="{Binding TsRemuxClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsTimelineRepair}"
                                      Command="{Binding TsTimelineRepairClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsMultiSourceRepair}"
                                      Command="{Binding TsMultiSourceRepairClickCommand}" />
                        </MenuItem>
                        <MenuItem Header="{DynamicResource String.Menu.ToolGroupMerge}">
                            <MenuItem Header="{DynamicResource String.Menu.MediaMux}"
                                      Command="{Binding MediaMuxClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsBinaryMerge}"
                                      Command="{Binding TsBinaryMergeClickCommand}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.Settings}"
                                  Command="{Binding SettingsClickCommand}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource String.Menu.View}">
                        <MenuItem Name="VideoFullScreenMenuItem" Header="{DynamicResource String.Playback.FullScreen}"
                                  Command="{Binding #CutterMainWindow.ToggleVideoFullScreenCommand}"
                                  ToggleType="CheckBox" IsChecked="{Binding #CutterMainWindow.IsVideoFullScreen, Mode=OneWay}"
                                  InputGesture="{OnPlatform F11, macOS=Ctrl+⌘+F}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.ZoomIn}" Command="{Binding ZoomInCommand}"/>
                        <MenuItem Header="{DynamicResource String.Menu.ZoomOut}" Command="{Binding ZoomOutCommand}"/>
                        <MenuItem Header="{DynamicResource String.Menu.OriginalSize}" Command="{Binding ZoomNoneCommand}"/>
                        <MenuItem Header="{DynamicResource String.Menu.Fit}" Command="{Binding FitCommand, ElementName=ImageViewer}"/>
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.ImageNavigator}"
                                  ToggleType="CheckBox" IsChecked="{Binding ShowImageNavigator, Mode=TwoWay}" />
                        <MenuItem Header="{DynamicResource String.Menu.KeyFrameStrip}"
                                  ToggleType="CheckBox" IsChecked="{Binding ShowKeyFrameStrip, Mode=TwoWay}" />
                        <MenuItem Header="{DynamicResource String.Menu.Theme}" ItemsSource="{Binding ThemeMenuItems}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource String.Menu.Help}">
                        <MenuItem Header="{DynamicResource String.Menu.CheckUpdate}"
                                  Command="{Binding CheckUpdateCommand}"/>
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.About}"
                                  Command="{Binding ShowAboutDialogCommand}"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </ClassicBorderDecorator>
        <!-- DropMask -->
        <Grid Grid.Row="1" ZIndex="2"
              IsVisible="False"
              IsHitTestVisible="False"
              x:Name="DropMask">
            <Border Background="{DynamicResource {x:Static commonControls:SystemColors.WindowBrushKey}}" Opacity="0.78" />
            <ClassicBorderDecorator x:Name="DropPanelFrame" BorderStyle="Raised"
                                    Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="24,Auto">
                    <Border x:Name="DropPanelTitle" Padding="8,2">
                        <TextBlock Text="TSCutter.GUI" Foreground="{DynamicResource DropTitleTextBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ClassicBorderDecorator x:Name="DropPanelContent" Grid.Row="1" BorderStyle="Sunken">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Image Classes="theme-icon" Source="{DynamicResource Icon.open}" Width="32" Height="32"
                                   Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Spacing="4" Width="220" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String.DropToolTip}" FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource String.Drop.Release}" FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ClassicBorderDecorator>
                </Grid>
            </ClassicBorderDecorator>
        </Grid>
        <DockPanel Grid.Row="1">
            <!-- 状态栏 -->
            <commonControls:StatusBar DockPanel.Dock="Bottom"
                                      VerticalAlignment="Center">
                <commonControls:StatusBarItem>
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding StatusInfoText}">
                    </TextBlock>
                </commonControls:StatusBarItem>
                <commonControls:StatusBarItem>
                    <Button x:Name="HardwareDecodingToggle" Classes="desktop-template-button"
                            Theme="{StaticResource PreviewStatusTextTheme}"
                            Content="{Binding DecodeModeText}"
                            Command="{Binding ToggleHardwareDecodingCommand}"
                            ToolTip.Tip="{DynamicResource String.Status.ToggleHardwareDecodingTip}" />
                </commonControls:StatusBarItem>
                <commonControls:StatusBarItem IsVisible="{Binding IsPlaybackActive}">
                    <TextBlock Name="PlaybackFps" Width="82" TextAlignment="Center" VerticalAlignment="Center"
                               Text="{Binding PlaybackFpsText}"
                               Classes.smooth="{Binding IsPlaybackSmooth}"
                               Classes.limited="{Binding IsPlaybackLimited}"
                               Classes.slow="{Binding IsPlaybackSlow}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock.smooth">
                                <Setter Property="Foreground" Value="{DynamicResource AppStatusSuccessForegroundBrush}" />
                            </Style>
                            <Style Selector="TextBlock.limited">
                                <Setter Property="Foreground" Value="{DynamicResource AppStatusWarningForegroundBrush}" />
                            </Style>
                            <Style Selector="TextBlock.slow">
                                <Setter Property="Foreground" Value="{DynamicResource AppStatusErrorForegroundBrush}" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </commonControls:StatusBarItem>
                <commonControls:StatusBarItem IsVisible="{Binding HasHdrPreview}">
                    <Button x:Name="ToneMappingToggle" Classes="desktop-template-button"
                            Theme="{StaticResource PreviewStatusTextTheme}"
                            Content="{Binding ToneMappingStatusText}"
                            Command="{Binding ToggleSdrToneMappingCommand}"
                            ToolTip.Tip="{DynamicResource String.Status.ToggleSdrToneMappingTip}" />
                </commonControls:StatusBarItem>
                <commonControls:StatusBarItem commonControls:StatusBar.Size="*">
                    <Button Command="{Binding OpenFileInExplorerCommand}"
                            Classes="hyperlink"
                            ToolTip.Tip="{DynamicResource String.FindFile}"
                            HorizontalAlignment="Left"
                            Content="{Binding VideoPath}"/>
                </commonControls:StatusBarItem>
            </commonControls:StatusBar>
            <!-- 主界面 -->
            <ClassicBorderDecorator Classes="app-section-frame" BorderStyle="Etched">
                <Grid RowDefinitions="Auto, *" Margin="0,2">
                    <commonControls:ToolBar Grid.Row="0" Margin="0,0,0,2" TextPlacement="Down" Size="Large">
                        <commonControls:RebarHandle />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.OpenVideoTip}"
                                                      LargeIcon="/Assets/directory_movie-3.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.open}"
                                                      Text="{DynamicResource String.ToolBar.Open}"
                                                      Command="{Binding LoadVideoClickCommand}" />
                        <Separator />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.ZoomIn}"
                                                      LargeIcon="/Assets/magnifying_glass_4-zoom-in.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.zoom-in}"
                                                      Text="{DynamicResource String.ToolBar.ZoomIn}"
                                                      Command="{Binding ZoomInCommand}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.ZoomOut}"
                                                      LargeIcon="/Assets/magnifying_glass_4-zoom-out.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.zoom-out}"
                                                      Text="{DynamicResource String.ToolBar.ZoomOut}"
                                                      Command="{Binding ZoomOutCommand}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.OriginalSize}"
                                                      LargeIcon="/Assets/original.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.original}"
                                                      Text="{DynamicResource String.ToolBar.OriginalSize}"
                                                      Command="{Binding ZoomNoneCommand}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.Fit}"
                                                      LargeIcon="/Assets/fit.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.fit}"
                                                      Text="{DynamicResource String.ToolBar.Fit}"
                                                      Command="{Binding FitCommand, ElementName=ImageViewer}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.KeyFrameOverviewTip}"
                                                      LargeIcon="/Assets/keyframe_overview.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.keyframes}"
                                                      Text="{DynamicResource String.ToolBar.KeyFrameOverview}"
                                                      Command="{Binding KeyFrameOverviewClickCommand}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.ThumbnailSheetTip}"
                                                      LargeIcon="/Assets/thumbnail_sheet.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.thumbnails}"
                                                      Text="{DynamicResource String.ToolBar.ThumbnailSheet}"
                                                      Command="{Binding ThumbnailSheetClickCommand}" />
                        <Separator />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.SaveFrameTip}"
                                                      LargeIcon="/Assets/kodak_imaging-0.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.snapshot}"
                                                      Text="{DynamicResource String.ToolBar.SaveFrame}"
                                                      Command="{Binding SaveFrameClickCommand}" />
                        <commonControls:ToolBarButton x:Name="CurrentFileToolsButton"
                                                      ToolTip.Tip="{DynamicResource String.ToolBar.FileToolsTip}"
                                                      LargeIcon="/Assets/file_tools.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.tools}"
                                                      Text="{DynamicResource String.ToolBar.FileTools}"
                                                      IsEnabled="{Binding CanUseFileToolsMenu}">
                            <commonControls:ToolBarButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem x:Name="CurrentPlaybackBenchmarkItem" Header="{DynamicResource String.Menu.PlaybackBenchmark}"
                                              Command="{Binding PlaybackBenchmarkClickCommand}" CommandParameter="{Binding VideoPath}"
                                              IsEnabled="{Binding CanUsePlaybackBenchmark}" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsCheck}" IsEnabled="{Binding CanUseCurrentFileTools}"
                                              Command="{Binding TsCheckClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsPacketViewer}" IsEnabled="{Binding CanUseCurrentFileTools}"
                                              Command="{Binding TsPacketViewerClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource String.FileTools.RawCutter}" IsEnabled="{Binding CanUseCurrentFileTools}"
                                              Command="{Binding RawCutterClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsFilterPid}" IsEnabled="{Binding CanUseCurrentFileTools}"
                                              Command="{Binding TsFilterClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsFilterService}" IsEnabled="{Binding CanUseCurrentFileTools}"
                                              Command="{Binding TsServiceFilterClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsEsExtractor}" IsEnabled="{Binding CanUseCurrentFileTools}"
                                              Command="{Binding TsEsExtractorClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsRemux}" IsEnabled="{Binding CanUseCurrentFileTools}"
                                              Command="{Binding TsRemuxClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsTimelineRepair}" IsEnabled="{Binding CanUseCurrentFileTools}"
                                              Command="{Binding TsTimelineRepairClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                </MenuFlyout>
                            </commonControls:ToolBarButton.Flyout>
                        </commonControls:ToolBarButton>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ZoomFactorStr}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.MediaInfoTip}"
                                                      LargeIcon="/Assets/file_eye.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.info}"
                                                      Text="{DynamicResource String.ToolBar.MediaInfo}"
                                                      HorizontalAlignment="Right"
                                                      Command="{Binding ShowMediaInfoClickCommand}" />
                    </commonControls:ToolBar>
                    <Grid Grid.Row="1" RowDefinitions="*, Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, 240">
                            <!-- 图片预览区域 -->
                            <ClassicBorderDecorator Grid.Column="0" Classes="app-preview-frame" BorderStyle="Etched">
                                <Grid x:Name="PreviewImageHost" RowDefinitions="Auto,*">
                                    <Grid Grid.Row="0" Margin="6,4" IsVisible="{Binding ShowPreviewTrackSelector}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding HasPreviewPrograms, Converter={x:Static views:MainWindow.OptionalTrackColumnWidthConverter}}" MaxWidth="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="{Binding HasPreviewSubtitles, Converter={x:Static views:MainWindow.OptionalTrackColumnWidthConverter}}" />
                                            <ColumnDefinition Width="*" MaxWidth="200" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,0,12,0"
                                              IsVisible="{Binding HasPreviewPrograms}">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                       Text="{DynamicResource String.PreviewTrack.Program}" />
                                            <ComboBox Grid.Column="1" MinHeight="28" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding CanSelectPreviewProgram}"
                                                      ItemsSource="{Binding PreviewPrograms}"
                                                      ToolTip.Tip="{Binding SelectedPreviewProgram.DisplayText}"
                                                      SelectedItem="{Binding SelectedPreviewProgram, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="modelsPreview:PreviewProgramOption">
                                                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding DisplayText}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <CheckBox Grid.Column="1" Margin="0,0,12,0" IsVisible="{Binding ShowProgramExportChoice}"
                                                  IsEnabled="{Binding CanChooseProgramExport}"
                                                  IsChecked="{Binding ExportCurrentProgramOnly, Mode=TwoWay}"
                                                  Content="{DynamicResource String.PreviewTrack.ExportCurrentProgramOnly}"
                                                  ToolTip.Tip="{DynamicResource String.PreviewTrack.ExportTip}" />
                                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,0,12,0">
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{DynamicResource String.PreviewTrack.Video}" />
                                            <ComboBox Grid.Column="1" MinHeight="28" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding CanSelectPreviewVideo}"
                                                      ItemsSource="{Binding PreviewVideoTracks}"
                                                      ToolTip.Tip="{Binding SelectedPreviewVideoTrack.DisplayText}"
                                                      SelectedItem="{Binding SelectedPreviewVideoTrack, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="modelsPreview:PreviewVideoTrackOption">
                                                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding DisplayText}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Grid.Column="3" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,0,12,0"
                                              IsVisible="{Binding HasPreviewSubtitles}">
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource String.SubtitlePreview.Label}"
                                                       ToolTip.Tip="{DynamicResource String.SubtitlePreview.Tip}" />
                                            <ComboBox Grid.Column="1" MinHeight="28" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding CanSelectPreviewSubtitle}"
                                                      ItemsSource="{Binding PreviewSubtitleTracks}"
                                                      SelectedItem="{Binding SelectedPreviewSubtitleTrack, Mode=TwoWay}"
                                                      ToolTip.Tip="{Binding SelectedPreviewSubtitleTrack.DisplayText}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="modelsPreview:PreviewSubtitleTrackOption">
                                                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding DisplayText}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ProgressBar Grid.Column="1" Height="2" MinHeight="0" VerticalAlignment="Bottom"
                                                         BorderThickness="0" Padding="0" ClipToBounds="True"
                                                         IsIndeterminate="True" IsVisible="{Binding IsSubtitleLoading}"
                                                         ToolTip.Tip="{DynamicResource String.SubtitlePreview.Loading}" />
                                        </Grid>
                                        <Grid Grid.Column="4">
                                            <TextBlock VerticalAlignment="Center" IsVisible="{Binding !HasPreviewAudioTracks}"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedPreviewProgram.AudioDescription}">
                                                <Run Text="{DynamicResource String.PreviewTrack.Audio}" />
                                                <Run Text="{Binding SelectedPreviewProgram.AudioDescription}" />
                                            </TextBlock>
                                            <ComboBox Name="PreviewAudioPicker" IsVisible="{Binding HasPreviewAudioTracks}"
                                                      MinHeight="28" ItemsSource="{Binding PreviewAudioTracks, Converter={x:Static views:MainWindow.AudioTrackItemsConverter}}"
                                                      IsEnabled="{Binding CanSelectPreviewAudio}"
                                                      SelectedValue="{Binding SelectedPreviewAudioTrack, Mode=TwoWay}"
                                                      SelectedValueBinding="{CompiledBinding Tag, DataType={x:Type ComboBoxItem}}"
                                                      PlaceholderText="{DynamicResource String.Playback.AudioTrackUnsupported}"
                                                      ToolTip.Tip="{Binding SelectedPreviewAudioTrack.DisplayText}">
                                            </ComboBox>
                                        </Grid>
                                    </Grid>
                                    <controls:ImageViewer Grid.Row="1" Name="ImageViewer"
                                                          IsEnabled="{Binding IsVideoInitialized}"
                                                          MaxZoomFactor="{Binding MaxZoomFactor}"
                                                          MinZoomFactor="{Binding MinZoomFactor}"
                                                          OffsetX="{Binding OffsetX, Mode=TwoWay}"
                                                          OffsetY="{Binding OffsetY, Mode=TwoWay}"
                                                          ShowNavigator="{Binding ViewerPreferences.ShowImageNavigator}"
                                                          Image="{Binding DecodedBitmap}"
                                                          GpuFrame="{Binding DecodedGpuFrame}"
                                                          SourcePixelSize="{Binding DecodedFrameSourceSize}"
                                                          SubtitleOverlay="{Binding SubtitleOverlay}"
                                                          Zoom="{Binding ZoomFactor, Mode=TwoWay}">
                                    </controls:ImageViewer>
                                    <Border Grid.Row="1" Name="PlaybackLoadingPanel" IsVisible="{Binding ShowPlaybackLoading}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                            Background="#DD202124" CornerRadius="8" Padding="18,12" IsHitTestVisible="False">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{DynamicResource String.Playback.Starting}" Foreground="White"
                                                       HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
                                            <ProgressBar IsIndeterminate="True" Width="180" Height="3" MinHeight="0"
                                                         BorderThickness="0" Background="#30FFFFFF" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" IsVisible="{Binding IsToolsOnly}"
                                            Background="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}"
                                            Padding="24">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding ToolsOnlyMessage}"
                                                       Foreground="{DynamicResource {x:Static commonControls:SystemColors.ControlTextBrushKey}}"
                                                       TextWrapping="Wrap" MaxWidth="480"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </ClassicBorderDecorator>
                            <GridSplitter Grid.Column="1" Width="3" />
                            <ClassicBorderDecorator Grid.Column="2" Classes="app-section-frame app-sidebar-frame" BorderStyle="Sunken">
                                <DockPanel>
                                    <!-- TabControl：片段列表和导出队列 -->
                                    <TabControl Name="RightTabControl">
                                        <!-- 片段列表 Tab -->
                                        <TabItem>
                                            <TabItem.Header>
                                                <TextBlock>
                                                    <Run Text="{DynamicResource String.Clips}" />
                                                </TextBlock>
                                            </TabItem.Header>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0" IsVisible="{Binding IsRemuxExport}">
                                                    <TextBlock Text="{DynamicResource String.RemuxExport.Notice}" TextWrapping="Wrap" FontSize="11" />
                                                    <Button Content="{DynamicResource String.RemuxExport.Options}" Command="{Binding RemuxExportOptionsCommand}" />
                                                </StackPanel>
                                                <Grid DockPanel.Dock="Bottom"
                                                      ColumnDefinitions="*,*"
                                                      ColumnSpacing="4"
                                                      Margin="0,2,0,0">
                                                    <Button Grid.Column="0"
                                                            Command="{Binding SelectAllClipsCommand}"
                                                            ToolTip.Tip="{DynamicResource String.Clips.SelectAllTip}">
                                                        <TextBlock Text="{DynamicResource String.Clips.SelectAll}" />
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding ExportAllCommand}"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="{DynamicResource String.ExportAllTip}">
                                                        <TextBlock Text="{DynamicResource String.ExportAll}" />
                                                    </Button>
                                                </Grid>
                                                <Grid>
                                                    <!-- Empty state -->
                                                    <TextBlock Text="{DynamicResource String.Clips.Empty}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                               IsVisible="{Binding Clips.Count, Converter={x:Static converters:ZeroToVisibilityConverter.Instance}}" />
                                                    <!-- Cards -->
                                                    <ScrollViewer Name="ClipsScrollViewer"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  IsVisible="{Binding Clips.Count, Converter={x:Static converters:PositiveToVisibilityConverter.Instance}}">
                                                        <ItemsControl ItemsSource="{Binding Clips}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,4"
                                                                        Padding="6"
                                                                        Classes.selected="{Binding IsSelected}"
                                                                        PointerPressed="ClipCard_OnPointerPressed">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                        </Style>
                                                                        <Style Selector="Border.selected">
                                                                            <Setter Property="Background" Value="{DynamicResource ClipSelectionBackgroundBrush}" />
                                                                        </Style>
                                                                    </Border.Styles>
                                                                    <Grid>
                                                                        <!-- Inactive: Raised border -->
                                                                        <ClassicBorderDecorator Classes="app-item-frame" BorderStyle="Raised"
                                                                                                IsVisible="{Binding IsActive, Converter={x:Static local:App.InverseBoolConverter}}" />
                                                                        <!-- Active editor: Sunken border -->
                                                                        <ClassicBorderDecorator Classes="app-item-frame" BorderStyle="Sunken"
                                                                                                IsVisible="{Binding IsActive}" />
                                                                        <!-- Content -->
                                                                        <Grid Margin="4"
                                                                              RowDefinitions="Auto,64,Auto,Auto"
                                                                              ColumnDefinitions="*,8,*">
                                                                            <Grid Grid.Row="0" Grid.ColumnSpan="3"
                                                                                  RowDefinitions="Auto,Auto" ColumnDefinitions="6,*,Auto,Auto" ColumnSpacing="6">
                                                                                <Border Background="{Binding LabelBrush}" IsVisible="{Binding HasColor}" Height="12" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" MaxLines="1" ToolTip.Tip="{Binding DisplayName}" FontWeight="Bold" FontSize="12"
                                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                                <Button Grid.Column="2" Theme="{StaticResource ClipEditButtonTheme}" Classes="desktop-template-button"
                                                                                        AutomationProperties.Name="{DynamicResource String.ClipDetails.Edit}"
                                                                                        Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).EditClipDetailsCommand}"
                                                                                        CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource String.ClipDetails.Edit}" />
                                                                                <Button Grid.Column="3" Theme="{StaticResource ClipExportStatusTheme}" Classes="desktop-template-button"
                                                                                        Classes.export-warning="{Binding HasExportWarning}" Classes.export-error="{Binding HasExportError}"
                                                                                        Content="{Binding StatusText}" IsVisible="{Binding HasExportStatus}"
                                                                                        IsEnabled="{Binding HasExportCheck}" VerticalAlignment="Center"
                                                                                        Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).OpenExportResultCommand}"
                                                                                        CommandParameter="{Binding}">
                                                                                    <ToolTip.Tip>
                                                                                        <TextBlock Text="{Binding ExportCheckTooltip}" MaxWidth="420" TextWrapping="Wrap" />
                                                                                    </ToolTip.Tip>
                                                                                </Button>
                                                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Notes}" MaxLines="1"
                                                                                           IsVisible="{Binding HasNotes}" TextTrimming="CharacterEllipsis" MaxHeight="20"
                                                                                           Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,2,0,3">
                                                                                    <ToolTip.Tip>
                                                                                        <TextBlock Text="{Binding Notes}" MaxWidth="320" TextWrapping="Wrap" MaxLines="8" TextTrimming="CharacterEllipsis" />
                                                                                    </ToolTip.Tip>
                                                                                </TextBlock>
                                                                            </Grid>
                                                                            <Button Grid.Row="1" Grid.Column="0" Padding="2"
                                                                                    MinWidth="0"
                                                                                    HorizontalContentAlignment="Stretch"
                                                                                    VerticalContentAlignment="Stretch"
                                                                                    IsEnabled="{Binding HasStartThumbnail}"
                                                                                    Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).JumpToStartTimeCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <Grid Background="{DynamicResource ClipThumbnailBackgroundBrush}"
                                                                                      ClipToBounds="True">
                                                                                    <Image Source="{Binding StartThumbnail}"
                                                                                           Stretch="Uniform" />
                                                                                    <TextBlock Text="—"
                                                                                               IsVisible="{Binding HasStartThumbnail, Converter={x:Static local:App.InverseBoolConverter}}"
                                                                                               Foreground="{DynamicResource ClipThumbnailPlaceholderBrush}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </Button>
                                                                            <Button Grid.Row="1" Grid.Column="2" Padding="2"
                                                                                    MinWidth="0"
                                                                                    HorizontalContentAlignment="Stretch"
                                                                                    VerticalContentAlignment="Stretch"
                                                                                    IsEnabled="{Binding HasEndThumbnail}"
                                                                                    Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).JumpToEndTimeCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <Grid Background="{DynamicResource ClipThumbnailBackgroundBrush}"
                                                                                      ClipToBounds="True">
                                                                                    <Image Source="{Binding EndThumbnail}"
                                                                                           Stretch="Uniform" />
                                                                                    <TextBlock Text="—"
                                                                                               IsVisible="{Binding HasEndThumbnail, Converter={x:Static local:App.InverseBoolConverter}}"
                                                                                               Foreground="{DynamicResource ClipThumbnailPlaceholderBrush}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </Button>

                                                                            <Button Grid.Row="2" Grid.Column="0"
                                                                                    Content="{Binding StartBoundaryTimeStr}"
                                                                                    Classes="hyperlink"
                                                                                    HorizontalAlignment="Center"
                                                                                    IsEnabled="{Binding HasStartThumbnail}"
                                                                                    Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).JumpToStartTimeCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button Grid.Row="2" Grid.Column="2"
                                                                                    Content="{Binding EndBoundaryTimeStr}"
                                                                                    Classes="hyperlink"
                                                                                    HorizontalAlignment="Center"
                                                                                    IsEnabled="{Binding HasEndThumbnail}"
                                                                                    Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).JumpToEndTimeCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <!-- Size + Output Path -->
                                                                            <Grid Grid.Row="3" Grid.ColumnSpan="3"
                                                                                  ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding EstimatedSizeStr}"
                                                                                           IsVisible="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).ShowRawClipSizeEstimate}"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0" />
                                                                                <TextBlock Text="{Binding ExportSizeStr}"
                                                                                           IsVisible="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).IsProgramExportFiltered}"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0" />
                                                                                <Button Grid.Column="1"
                                                                                        Content="{Binding OutputFilePathStr}"
                                                                                        Classes="hyperlink"
                                                                                        HorizontalContentAlignment="Stretch"
                                                                                        IsVisible="{Binding OutputFileInfo, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                                                                                        Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).FindFileCommand}"
                                                                                        CommandParameter="{Binding OutputFileInfo}" />
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </DockPanel>
                                        </TabItem>
                                        <!-- 导出队列 Tab -->
                                        <TabItem>
                                            <TabItem.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{DynamicResource String.ExportQueue}" />
                                                    <Border CornerRadius="8"
                                                            Padding="4,1"
                                                            MinWidth="18"
                                                            HorizontalAlignment="Center"
                                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                            BorderThickness="1"
                                                            IsVisible="{Binding HasExportQueue}">
                                                        <TextBlock FontSize="10"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Text="{Binding ExportQueueCount}" />
                                                    </Border>
                                                </StackPanel>
                                            </TabItem.Header>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasRemuxQueue}">
                                                    <TextBlock Text="{DynamicResource String.RemuxExport.Notice}" TextWrapping="Wrap"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <!-- 底部按钮 -->
                                                <Grid DockPanel.Dock="Bottom"
                                                      ColumnDefinitions="*,*"
                                                      ColumnSpacing="4"
                                                      Margin="0,2,0,0">
                                                    <Grid.Styles>
                                                        <Style Selector="Button:disabled Image">
                                                            <Setter Property="Opacity" Value="0.3" />
                                                        </Style>
                                                    </Grid.Styles>
                                                    <Button Grid.Column="0"
                                                            Command="{Binding ClearQueueCommand}">
                                                        <TextBlock Text="{DynamicResource String.ClearQueue}" />
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding BatchExportQueueCommand}"
                                                            Classes="accent">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Image Classes="theme-icon" Height="16" Source="{DynamicResource Icon.save}" />
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Text="{DynamicResource String.BatchExportQueue}"
                                                                       Margin="4,0,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <Grid>
                                                    <!-- Empty state -->
                                                    <TextBlock Text="{DynamicResource String.QueueEmpty}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                               IsVisible="{Binding HasExportQueue, Converter={x:Static local:App.InverseBoolConverter}}" />
                                                    <!-- Queue cards -->
                                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                                  IsVisible="{Binding HasExportQueue}">
                                                        <ItemsControl Name="ExportQueueList" ItemsSource="{Binding ExportQueue}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ExportQueueItem">
                                                                <Border Margin="0,0,0,4"
                                                                        Padding="6">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                        </Style>
                                                                    </Border.Styles>
                                                                    <Grid>
                                                                        <ClassicBorderDecorator Classes="app-item-frame" BorderStyle="Raised" />
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                        <StackPanel Grid.Column="0" Margin="4" Spacing="2">
                                                                            <Grid ColumnDefinitions="6,*" ColumnSpacing="6">
                                                                                <Border Background="{Binding LabelBrush}" IsVisible="{Binding HasColor}" Height="12" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" MaxLines="1" ToolTip.Tip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="Bold" FontSize="12" />
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding Notes}" MaxLines="1" IsVisible="{Binding HasNotes}" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{DynamicResource AppSecondaryTextBrush}" MaxHeight="20">
                                                                                <ToolTip.Tip>
                                                                                    <TextBlock Text="{Binding Notes}" MaxWidth="320" TextWrapping="Wrap" MaxLines="8" TextTrimming="CharacterEllipsis" />
                                                                                </ToolTip.Tip>
                                                                            </TextBlock>
                                                                            <!-- Boundary times -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding StartBoundaryTimeStr}" />
                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding EndBoundaryTimeStr}" />
                                                                            </Grid>
                                                                            <!-- Size + Output path -->
                                                                            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding EstimatedSizeStr}"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0" />
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding OutputFilePathStr}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        <!-- 关闭按钮 × -->
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="×"
                                                                                   FontSize="14"
                                                                                   VerticalAlignment="Top"
                                                                                   Margin="0,2,4,0"
                                                                                   Cursor="Hand"
                                                                                   PointerPressed="QueueRemove_OnPointerPressed"
                                                                                   ToolTip.Tip="{DynamicResource String.QueueRemove}" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </DockPanel>
                                        </TabItem>
                                    </TabControl>
                                </DockPanel>
                            </ClassicBorderDecorator>
                        </Grid>
                        <!-- 时间刻度、剪辑范围、播放头、总览与缩放共用同一套坐标换算。 -->
                        <StackPanel Grid.Row="1">
                            <controls:KeyFrameStripControl Name="KeyFrameStripView" Items="{Binding KeyFrameStrip.Items}"
                                                          Ranges="{Binding KeyFrameStripRanges}"
                                                          ClipBrush="{DynamicResource AppStatusSuccessForegroundBrush}"
                                                          TextBrush="{DynamicResource {x:Static commonControls:SystemColors.WindowTextColorKey}}"
                                                          BorderBrush="{DynamicResource {x:Static commonControls:SystemColors.GrayTextColorKey}}"
                                                          AccentBrush="{DynamicResource AppRepairMapSelectionBrush}"
                                                          IsVisible="{Binding IsKeyFrameStripVisible}"
                                                          IsEnabled="{Binding IsVideoInitialized}"
                                                          SizeChanged="KeyFrameStrip_OnSizeChanged"
                                                          SeekRequested="KeyFrameStrip_OnSeekRequested" />
                            <controls:TimelineControl
                                                      Name="MainTimeline"
                                                      IsEnabled="{Binding IsVideoInitialized}"
                                                      Focusable="True"
                                                      Height="48"
                                                      Margin="0,2"
                                                      HorizontalAlignment="Stretch"
                                                      Minimum="0"
                                                      Maximum="{Binding DurationMax}"
                                                      Value="{Binding CurrentTime}"
                                                      ViewportStart="{Binding TimelineViewport.ViewStart}"
                                                      ViewportEnd="{Binding TimelineViewport.ViewEnd}"
                                                      ZoomLevel="{Binding TimelineViewport.ZoomLevel}"
                                                      Ranges="{Binding SelectedClipRanges}"
                                                      ScrubStarted="Timeline_OnScrubStarted"
                                                      ScrubPositionChanged="Timeline_OnScrubPositionChanged"
                                                      ScrubPreviewRequested="Timeline_OnScrubPreviewRequested"
                                                      ScrubCanceled="Timeline_OnScrubCanceled"
                                                      SeekRequested="Timeline_OnSeekRequested"
                                                      PanRequested="Timeline_OnPanRequested"
                                                      ZoomRequested="Timeline_OnZoomRequested"
                                                      FitRequested="Timeline_OnFitRequested"
                                                      TextBrush="{DynamicResource {x:Static commonControls:SystemColors.WindowTextColorKey}}"
                                                      MutedTextBrush="{DynamicResource {x:Static commonControls:SystemColors.GrayTextColorKey}}"
                                                      ClipBrush="{DynamicResource AppStatusSuccessForegroundBrush}"
                                                      AccentBrush="{DynamicResource AppRepairMapSelectionBrush}"
                                                      ViewportBrush="{DynamicResource AppRepairMapSelectionBrush}"
                                                      FitTip="{DynamicResource String.Timeline.FitTip}"
                                                      ZoomTip="{DynamicResource String.Timeline.ZoomTip}"
                                                      ScrollTip="{DynamicResource String.Timeline.ScrollTip}" />
                        </StackPanel>
                        <!-- 时间码与摘要共用上行，剪辑、播放、音量和保存共用操作行。 -->
                        <Grid Grid.Row="2" Name="PlaybackControls"
                              RowDefinitions="26,Auto" ColumnSpacing="10" RowSpacing="4" Margin="4,2,4,4"
                              IsEnabled="{Binding IsVideoInitialized}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="132" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="132" />
                            </Grid.ColumnDefinitions>
                            <Grid.Styles>
                                <!-- 底部操作提示固定在按钮上方，避免最大化时被屏幕边界挤回鼠标位置。 -->
                                <Style Selector="Button">
                                    <Setter Property="ToolTip.Placement" Value="Top" />
                                    <Setter Property="ToolTip.VerticalOffset" Value="-6" />
                                </Style>
                                <Style Selector="Button.LeftBtn">
                                    <Setter Property="Width" Value="30" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style Selector="Button.CenterBtn">
                                    <Setter Property="MinWidth" Value="30" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="4,6" />
                                </Style>
                                <Style Selector="Button.LeftBtn, Button.CenterBtn">
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </Grid.Styles>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0" VerticalAlignment="Center">
                                <Button Command="{Binding MarkClipStartCommand}"
                                        Classes="LeftBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.MarkStart}">
                                    [
                                </Button>
                                <Button Command="{Binding MarkClipEndCommand}"
                                        Classes="LeftBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.MarkEnd}">
                                    ]
                                </Button>
                                <Button Command="{Binding AddClipCommand}"
                                        Classes="LeftBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.AddClip}">
                                    +
                                </Button>
                                <Button Command="{Binding RemoveClipCommand}"
                                        Classes="LeftBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.RemoveClip}">
                                    -
                                </Button>
                            </StackPanel>
                            <Button Grid.Row="0" Grid.Column="0" Name="VideoFullScreenButton"
                                    Command="{Binding #CutterMainWindow.ToggleVideoFullScreenCommand}"
                                    ToolTip.Tip="{DynamicResource String.Playback.FullScreen}" Width="28" Height="26"
                                    MinHeight="0" MinWidth="0" Padding="5" HorizontalAlignment="Left">
                                <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Stretch="Uniform"
                                      Data="M 5,0 H 0 V 5 M 9,0 H 14 V 5 M 0,9 V 14 H 5 M 9,14 H 14 V 9" />
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" Name="PlaybackTimeButton" Width="150" Height="26"
                                    Content="{Binding CurrentTime, Converter={StaticResource SecondsConverter}}"
                                    Command="{Binding JumpToClickCommand}" Classes="hyperlink"
                                    ToolTip.Tip="{DynamicResource String.Navigate.JumpTo}"
                                    FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Name="PlaybackNavigationControls" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Command="{Binding Prev20GopClickCommand}" Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Previous20}" Content="&lt;&lt;&lt;" />
                                <Button Command="{Binding Prev10GopClickCommand}" Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Previous10}" Content="&lt;&lt;" />
                                <Button Command="{Binding PrevGopClickCommand}" Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Previous}" Content="&lt;" />
                                <Button Name="PlayPauseButton" Command="{Binding TogglePlaybackCommand}"
                                        Classes="CenterBtn" Width="38" Margin="4,0"
                                        ToolTip.Tip="{Binding PlaybackButtonToolTip}">
                                    <Grid Width="14" Height="14">
                                        <Grid IsVisible="{Binding !IsPlaybackStarting}">
                                            <Path Data="M 2,0 L 14,7 L 2,14 Z" Stretch="Uniform"
                                                  Fill="{Binding $parent[Button].Foreground}" IsVisible="{Binding !IsPlaybackActive}" />
                                            <Path Data="M 1,0 L 5,0 L 5,14 L 1,14 Z M 9,0 L 13,0 L 13,14 L 9,14 Z"
                                                  Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"
                                                  IsVisible="{Binding IsPlaybackActive}" />
                                        </Grid>
                                        <Border Width="9" Height="9" Background="{Binding $parent[Button].Foreground}"
                                                IsVisible="{Binding IsPlaybackStarting}" />
                                    </Grid>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource String.Playback.PlayClip}"
                                                      Command="{Binding PlaySelectedClipCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Command="{Binding NextGopClickCommand}" Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Next}" Content="&gt;" />
                                <Button Command="{Binding Next10GopClickCommand}" Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Next10}" Content="&gt;&gt;" />
                                <Button Command="{Binding Next20GopClickCommand}" Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Next20}" Content="&gt;&gt;&gt;" />
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" Text="!" Width="28" TextAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding HasPlaybackAudioProblem}"
                                       ToolTip.Tip="{Binding PlaybackAudioStatusText}" />
                            <!-- 摘要放在保存按钮上方；窄窗口截断文字，不挤占播放操作。 -->
                            <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="6"
                                  MaxWidth="240" Margin="34,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedClipsSummaryStr}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding SelectedClipsSummaryStr}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedClipEstimatedSizeStr, Mode=OneWay}"
                                           FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="10"
                                  VerticalAlignment="Center">
                                <Grid Name="PlaybackAudioControls" ColumnDefinitions="28,*"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" ColumnSpacing="6">
                                    <Button Command="{Binding TogglePreviewMuteCommand}" Name="PreviewMuteButton"
                                            Padding="3" Width="28" Height="32" MinHeight="0" MinWidth="0"
                                            ToolTip.Tip="{Binding MuteButtonToolTip}">
                                        <Grid Width="15" Height="14">
                                            <Path Data="M 0,5 L 4,5 L 9,1 L 9,13 L 4,9 L 0,9 Z"
                                                  Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" />
                                            <Path Data="M 0,0 L 14,14 M 0,14 L 14,0" StrokeThickness="1.5"
                                                  Stroke="{Binding $parent[Button].Foreground}" IsVisible="{Binding PreviewMuted}" />
                                        </Grid>
                                    </Button>
                                    <Grid Grid.Column="1" Name="PreviewVolumeSlot" SizeChanged="PreviewVolumeSlot_OnSizeChanged">
                                        <Slider Name="PreviewVolumeSlider" MinWidth="24" MaxWidth="72"
                                                Width="72" Minimum="0" Maximum="1"
                                                SmallChange="0.05" Value="{Binding PreviewVolume, Mode=TwoWay}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                ToolTip.Tip="{DynamicResource String.Playback.Volume}" />
                                    </Grid>
                                </Grid>
                                <Button Grid.Column="1" Command="{Binding ClipOutputCommand}"
                                        Classes="accent" Height="32" MinHeight="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="{Binding ClipOutputToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Classes="theme-icon" Height="16" Source="{DynamicResource Icon.save}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding ClipOutputText}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ClassicBorderDecorator>
        </DockPanel>
        <Grid Grid.RowSpan="2"
              ZIndex="99"
              IsVisible="{Binding IsDecoding}"
              Background="Transparent" />
        </Grid>
        <Grid Name="FullScreenSurface" Grid.RowSpan="2" ZIndex="100" Background="Black" IsVisible="False" Focusable="True">
            <Border Name="FullScreenVideoHost" />
            <Border Name="FullScreenPlaybackLoadingPanel" IsVisible="{Binding ShowPlaybackLoading}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                    Background="#DD202124" CornerRadius="8" Padding="18,12" IsHitTestVisible="False">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource String.Playback.Starting}" Foreground="White"
                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
                    <ProgressBar IsIndeterminate="True" Width="180" Height="3" MinHeight="0"
                                 BorderThickness="0" Background="#30FFFFFF" Foreground="White" />
                </StackPanel>
            </Border>
            <Border Name="FullScreenControls" VerticalAlignment="Bottom" Padding="24,40,24,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#E6101114" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Transitions>
                    <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
                </Border.Transitions>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" MaxWidth="1200">
                    <Slider Name="FullScreenSeekSlider" Focusable="True" Minimum="0" Maximum="{Binding DurationMax}"
                            Value="{Binding CurrentTime, Mode=OneWay}" SmallChange="5" LargeChange="30"
                            HorizontalAlignment="Stretch" Foreground="White" />
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                        <Button Name="FullScreenPlayPauseButton" Classes="fullscreen-action"
                                Command="{Binding TogglePlaybackCommand}" ToolTip.Tip="{Binding PlaybackButtonToolTip}">
                            <Grid Width="16" Height="16">
                                <Grid IsVisible="{Binding !IsPlaybackStarting}">
                                    <Path Data="M 2,0 L 16,8 L 2,16 Z" Fill="White" IsVisible="{Binding !IsPlaybackActive}" />
                                    <Path Data="M 2,0 H 6 V 16 H 2 Z M 10,0 H 14 V 16 H 10 Z"
                                          Fill="White" IsVisible="{Binding IsPlaybackActive}" />
                                </Grid>
                                <Border Width="10" Height="10" Background="White" IsVisible="{Binding IsPlaybackStarting}" />
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Foreground="White" Text="{Binding CurrentTime, Converter={StaticResource SecondsConverter}}" />
                            <TextBlock Foreground="#BFC3CA" Text="/" />
                            <TextBlock Foreground="#BFC3CA" Text="{Binding DurationMax, Converter={StaticResource SecondsConverter}}" />
                            <TextBlock Foreground="#FFD287" Text="!" IsVisible="{Binding HasPlaybackAudioProblem}"
                                       ToolTip.Tip="{Binding PlaybackAudioStatusText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Name="FullScreenMuteButton" Classes="fullscreen-action" Command="{Binding TogglePreviewMuteCommand}"
                                    ToolTip.Tip="{Binding MuteButtonToolTip}">
                                <Grid Width="16" Height="16">
                                    <Path Data="M 0,5 H 4 L 9,1 V 15 L 4,11 H 0 Z" Fill="White" />
                                    <Path Data="M 1,1 L 15,15 M 1,15 L 15,1" Stroke="White" StrokeThickness="1.5"
                                          IsVisible="{Binding PreviewMuted}" />
                                </Grid>
                            </Button>
                            <Slider Name="FullScreenVolumeSlider" Focusable="True" Width="88" Minimum="0" Maximum="1" SmallChange="0.05"
                                    Value="{Binding PreviewVolume, Mode=TwoWay}" VerticalAlignment="Center"
                                    ToolTip.Tip="{DynamicResource String.Playback.Volume}" />
                        </StackPanel>
                        <Button Grid.Column="3" Classes="fullscreen-action" Name="ExitVideoFullScreenButton"
                                Command="{Binding #CutterMainWindow.ToggleVideoFullScreenCommand}"
                                ToolTip.Tip="{DynamicResource String.Window.ExitFullScreen}">
                            <Path Width="16" Height="16" Stroke="White" StrokeThickness="1.5" Stretch="Uniform"
                                  Data="M 0,5 H 5 V 0 M 9,0 V 5 H 14 M 0,9 H 5 V 14 M 9,14 V 9 H 14" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <Border IsVisible="{Binding IsDecoding}" Background="Transparent" />
        </Grid>
    </Grid>
</Window>
