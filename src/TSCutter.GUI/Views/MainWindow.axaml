<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TSCutter.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ia="using:Avalonia.Xaml.Interactivity"
        xmlns:themes="using:TSCutter.GUI.Themes"
        xmlns:controls="clr-namespace:TSCutter.GUI.Controls"
        xmlns:converters="clr-namespace:TSCutter.GUI.Converters"
        xmlns:local="clr-namespace:TSCutter.GUI"
        xmlns:models="clr-namespace:TSCutter.GUI.Models"
        xmlns:commonControls="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        mc:Ignorable="d"
        Width="940" Height="650"
        MinWidth="670" MinHeight="400"
        x:Class="TSCutter.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="CutterMainWindow"
        DragDrop.AllowDrop="True"
        Focusable="True"
        Closing="Window_OnClosing"
        Icon="/Assets/logo.ico"
        DataContext="{x:Static local:App.MainWindow}"
        WindowStartupLocation="CenterScreen"
        Title="{Binding WindowTitle}">

    <Window.Resources>
        <converters:SecondsToStringConverter x:Key="SecondsConverter" />
        <ControlTheme x:Key="ClipEditButtonTheme" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static commonControls:SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Path Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeJoin="Round"
                              Data="M 2,9 L 2,12 L 5,12 L 12,5 L 9,2 Z M 7.5,3.5 L 10.5,6.5" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource {x:Static commonControls:SystemColors.ControlLightBrushKey}}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource {x:Static commonControls:SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static commonControls:SystemColors.HighlightTextBrushKey}}" />
            </Style>
            <Style Selector="^:focus-visible">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static commonControls:SystemColors.HighlightBrushKey}}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static commonControls:SystemColors.GrayTextBrushKey}}" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Interaction.Behaviors>
        <RoutedEventTriggerBehavior RoutedEvent="{x:Static Control.LoadedEvent}">
            <InvokeCommandAction Command="{Binding ProcessCommandLineCommand}" />
        </RoutedEventTriggerBehavior>
    </Interaction.Behaviors>
    
    <Window.Styles>
        <Style Selector="ClassicBorderDecorator#DropPanelFrame">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}" />
        </Style>
        <Style Selector="Border#DropPanelTitle">
            <Setter Property="Background" Value="{DynamicResource DropTitleBrush}" />
        </Style>
        <Style Selector="ClassicBorderDecorator#DropPanelContent">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="14,16" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.hyperlink">
            <Setter Property="Template">
                <ControlTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Text="{TemplateBinding Content}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock:pointerover">
                                <Setter Property="TextDecorations" Value="Underline" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>
    
    <!-- Don't know why NativeMenuItem's Gesture only works on macOS, so here add KeyBindings -->
    <Window.KeyBindings>
        <KeyBinding Gesture="{OnPlatform Ctrl+O, macOS=⌘+O}" Command="{Binding LoadVideoClickCommand}"/>
        <KeyBinding Gesture="{OnPlatform Ctrl+S, macOS=⌘+S}" Command="{Binding SaveVideoClickCommand}"/>
        <KeyBinding Gesture="{OnPlatform Ctrl+Z, macOS=⌘+Z}" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="{OnPlatform Ctrl+Y, macOS=⌘+Shift+Z}" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Left" Command="{Binding PrevGopClickCommand}"/>
        <KeyBinding Gesture="Shift+Left" Command="{Binding Prev10GopClickCommand}"/>
        <KeyBinding Gesture="Right" Command="{Binding NextGopClickCommand}"/>
        <KeyBinding Gesture="Shift+Right" Command="{Binding Next10GopClickCommand}"/>
        <KeyBinding Gesture="I" Command="{Binding MarkClipStartShortcutCommand}"/>
        <KeyBinding Gesture="O" Command="{Binding MarkClipEndShortcutCommand}"/>
    </Window.KeyBindings>

    <NativeMenu.Menu>
        <NativeMenu>
        </NativeMenu>
    </NativeMenu.Menu>

    <Grid x:Name="DropSurface" RowDefinitions="Auto, *">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ClipSelectionBackgroundBrush"
                                         Color="{DynamicResource SystemAccentColorLight1}" />
                        <SolidColorBrush x:Key="ClipThumbnailBackgroundBrush" Color="#303236" />
                        <SolidColorBrush x:Key="ClipThumbnailPlaceholderBrush" Color="#D8DADD" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <!-- 选中卡片只做轻微蓝色染色，避免与标题栏、进度条争夺视觉焦点。 -->
                        <SolidColorBrush x:Key="ClipSelectionBackgroundBrush" Color="#2B3B4B" />
                        <SolidColorBrush x:Key="ClipThumbnailBackgroundBrush" Color="#111316" />
                        <SolidColorBrush x:Key="ClipThumbnailPlaceholderBrush" Color="#969DA5" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <LinearGradientBrush x:Key="DropTitleBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="{DynamicResource {x:Static commonControls:SystemColors.ActiveCaptionColorKey}}" Offset="0" />
                    <GradientStop Color="{DynamicResource {x:Static commonControls:SystemColors.GradientActiveCaptionColorKey}}" Offset="1" />
                </LinearGradientBrush>
                <SolidColorBrush x:Key="DropTitleTextBrush"
                                 Color="{DynamicResource {x:Static commonControls:SystemColors.ActiveCaptionTextColorKey}}" />
            </ResourceDictionary>
        </Grid.Resources>
        <ClassicBorderDecorator Grid.Row="0" DockPanel.Dock="Top" Classes="app-section-frame app-menu-frame" BorderStyle="Etched">
            <DockPanel Margin="0, 2">
                <commonControls:RebarHandle />
                <Menu>
                    <MenuItem Header="{DynamicResource String.Menu.File}">
                        <MenuItem Header="{DynamicResource String.Menu.OpenVideo}"
                                  Command="{Binding LoadVideoClickCommand}"
                                  InputGesture="{OnPlatform Ctrl+O, macOS=⌘+O}" />
                        <MenuItem Header="{DynamicResource String.Project.Open}"
                                  Command="{Binding OpenProjectCommand}" />
                        <MenuItem Header="{DynamicResource String.Project.Save}"
                                  Command="{Binding SaveProjectCommand}" />
                        <MenuItem Header="{DynamicResource String.Project.SaveAs}"
                                  Command="{Binding SaveProjectAsCommand}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.SaveClip}"
                                  Command="{Binding SaveVideoClickCommand}"
                                  InputGesture="{OnPlatform Ctrl+S, macOS=⌘+S}" />
                        <MenuItem Header="{DynamicResource String.Menu.KeyFrameOverview}"
                                  Command="{Binding KeyFrameOverviewClickCommand}" />
                        <MenuItem Header="{DynamicResource String.Menu.ThumbnailSheet}"
                                  Command="{Binding ThumbnailSheetClickCommand}" />
                        <MenuItem Header="{DynamicResource String.AddToQueue}"
                                  Command="{Binding AddToQueueCommand}" />
                        <MenuItem Header="{DynamicResource String.MergeClips.Menu}"
                                  Command="{Binding MergeSelectedClipsCommand}" />
                        <MenuItem Header="{DynamicResource String.RemuxExport.Options}"
                                  IsVisible="{Binding IsRemuxExport}" Command="{Binding RemuxExportOptionsCommand}" />
                        <MenuItem Header="{DynamicResource String.RemuxExport.MergeQueue}"
                                  Command="{Binding MergeRemuxQueueCommand}" IsVisible="{Binding HasRemuxQueue}" />
                        <MenuItem Header="{DynamicResource String.Menu.ExportQueue}"
                                  Command="{Binding BatchExportQueueCommand}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.CloseVideo}"
                                  Command="{Binding CloseVideoClickCommand}"/>
                        <MenuItem Header="{DynamicResource String.Menu.Exit}"
                                  Command="{Binding ExitApplicationCommand}"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource String.Menu.Edit}">
                        <MenuItem Header="{DynamicResource String.Menu.Undo}"
                                  Command="{Binding UndoCommand}"
                                  InputGesture="{OnPlatform Ctrl+Z, macOS=⌘+Z}" />
                        <MenuItem Header="{DynamicResource String.Menu.Redo}"
                                  Command="{Binding RedoCommand}"
                                  InputGesture="{OnPlatform Ctrl+Y, macOS=⌘+Shift+Z}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource String.Menu.Tools}">
                        <MenuItem Header="{DynamicResource String.FrameSearch.Menu}"
                                  Command="{Binding FrameSearchClickCommand}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.ToolGroupAnalyze}">
                            <MenuItem Header="{DynamicResource String.Menu.TsCheck}">
                                <MenuItem Header="{DynamicResource String.Menu.TsCheck.Single}"
                                          Command="{Binding TsCheckClickCommand}" />
                                <MenuItem Header="{DynamicResource String.Menu.TsCheck.Batch}"
                                          Command="{Binding TsBatchCheckClickCommand}" />
                            </MenuItem>
                            <MenuItem Header="{DynamicResource String.Menu.TsPacketViewer}"
                                      Command="{Binding TsPacketViewerClickCommand}" />
                        </MenuItem>
                        <MenuItem Header="{DynamicResource String.Menu.ToolGroupExtract}">
                            <MenuItem Header="{DynamicResource String.Menu.RawCutter}"
                                      Command="{Binding RawCutterClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsFilterPid}"
                                      Command="{Binding TsFilterClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsFilterService}"
                                      Command="{Binding TsServiceFilterClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsEsExtractor}"
                                      Command="{Binding TsEsExtractorClickCommand}" />
                        </MenuItem>
                        <MenuItem Header="{DynamicResource String.Menu.ToolGroupEdit}">
                            <MenuItem Header="{DynamicResource String.Menu.TsRemux}"
                                      Command="{Binding TsRemuxClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsTimelineRepair}"
                                      Command="{Binding TsTimelineRepairClickCommand}" />
                            <MenuItem Header="{DynamicResource String.Menu.TsMultiSourceRepair}"
                                      Command="{Binding TsMultiSourceRepairClickCommand}" />
                        </MenuItem>
                        <MenuItem Header="{DynamicResource String.Menu.ToolGroupMerge}">
                            <MenuItem Header="{DynamicResource String.Menu.TsBinaryMerge}"
                                      Command="{Binding TsBinaryMergeClickCommand}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.Settings}"
                                  Command="{Binding SettingsClickCommand}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource String.Menu.View}">
                        <MenuItem Header="{DynamicResource String.Menu.ZoomIn}" Command="{Binding ZoomInCommand}"/>
                        <MenuItem Header="{DynamicResource String.Menu.ZoomOut}" Command="{Binding ZoomOutCommand}"/>
                        <MenuItem Header="{DynamicResource String.Menu.OriginalSize}" Command="{Binding ZoomNoneCommand}"/>
                        <MenuItem Header="{DynamicResource String.Menu.Fit}" Command="{Binding FitCommand, ElementName=ImageViewer}"/>
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.Theme}" ItemsSource="{Binding ThemeMenuItems}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource String.Menu.Help}">
                        <MenuItem Header="{DynamicResource String.Menu.CheckUpdate}"
                                  Command="{Binding CheckUpdateCommand}"/>
                        <Separator />
                        <MenuItem Header="{DynamicResource String.Menu.About}"
                                  Command="{Binding ShowAboutDialogCommand}"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </ClassicBorderDecorator>
        <!-- DropMask -->
        <Grid Grid.Row="1" ZIndex="2"
              IsVisible="False"
              IsHitTestVisible="False"
              x:Name="DropMask">
            <Border Background="{DynamicResource {x:Static commonControls:SystemColors.WindowBrushKey}}" Opacity="0.78" />
            <ClassicBorderDecorator x:Name="DropPanelFrame" BorderStyle="Raised"
                                    Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="24,Auto">
                    <Border x:Name="DropPanelTitle" Padding="8,2">
                        <TextBlock Text="TSCutter.GUI" Foreground="{DynamicResource DropTitleTextBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ClassicBorderDecorator x:Name="DropPanelContent" Grid.Row="1" BorderStyle="Sunken">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Image Classes="theme-icon" Source="{DynamicResource Icon.open}" Width="32" Height="32"
                                   Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Spacing="4" Width="220" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String.DropToolTip}" FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource String.Drop.Release}" FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ClassicBorderDecorator>
                </Grid>
            </ClassicBorderDecorator>
        </Grid>
        <DockPanel Grid.Row="1">
            <!-- 状态栏 -->
            <commonControls:StatusBar DockPanel.Dock="Bottom"
                                      VerticalAlignment="Center">
                <commonControls:StatusBarItem>
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding StatusInfoText}">
                    </TextBlock>
                </commonControls:StatusBarItem>
                <commonControls:StatusBarItem commonControls:StatusBar.Size="*">
                    <Button Command="{Binding OpenFileInExplorerCommand}"
                            Classes="hyperlink"
                            ToolTip.Tip="{DynamicResource String.FindFile}"
                            HorizontalAlignment="Left"
                            Content="{Binding VideoPath}"/>
                </commonControls:StatusBarItem>
            </commonControls:StatusBar>
            <!-- 主界面 -->
            <ClassicBorderDecorator Classes="app-section-frame" BorderStyle="Etched">
                <Grid RowDefinitions="Auto, *" Margin="0,2">
                    <commonControls:ToolBar Grid.Row="0" Margin="0,0,0,2" TextPlacement="Down" Size="Large">
                        <commonControls:RebarHandle />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.OpenVideoTip}"
                                                      LargeIcon="/Assets/directory_movie-3.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.open}"
                                                      Text="{DynamicResource String.ToolBar.Open}"
                                                      Command="{Binding LoadVideoClickCommand}" />
                        <Separator />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.ZoomIn}"
                                                      LargeIcon="/Assets/magnifying_glass_4-zoom-in.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.zoom-in}"
                                                      Text="{DynamicResource String.ToolBar.ZoomIn}"
                                                      Command="{Binding ZoomInCommand}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.ZoomOut}"
                                                      LargeIcon="/Assets/magnifying_glass_4-zoom-out.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.zoom-out}"
                                                      Text="{DynamicResource String.ToolBar.ZoomOut}"
                                                      Command="{Binding ZoomOutCommand}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.OriginalSize}"
                                                      LargeIcon="/Assets/original.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.original}"
                                                      Text="{DynamicResource String.ToolBar.OriginalSize}"
                                                      Command="{Binding ZoomNoneCommand}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.Fit}"
                                                      LargeIcon="/Assets/fit.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.fit}"
                                                      Text="{DynamicResource String.ToolBar.Fit}"
                                                      Command="{Binding FitCommand, ElementName=ImageViewer}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.KeyFrameOverviewTip}"
                                                      LargeIcon="/Assets/keyframe_overview.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.keyframes}"
                                                      Text="{DynamicResource String.ToolBar.KeyFrameOverview}"
                                                      Command="{Binding KeyFrameOverviewClickCommand}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.ThumbnailSheetTip}"
                                                      LargeIcon="/Assets/thumbnail_sheet.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.thumbnails}"
                                                      Text="{DynamicResource String.ToolBar.ThumbnailSheet}"
                                                      Command="{Binding ThumbnailSheetClickCommand}" />
                        <Separator />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.SaveFrameTip}"
                                                      LargeIcon="/Assets/kodak_imaging-0.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.snapshot}"
                                                      Text="{DynamicResource String.ToolBar.SaveFrame}"
                                                      Command="{Binding SaveFrameClickCommand}" />
                        <commonControls:ToolBarButton x:Name="CurrentFileToolsButton"
                                                      ToolTip.Tip="{DynamicResource String.ToolBar.FileToolsTip}"
                                                      LargeIcon="/Assets/file_tools.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.tools}"
                                                      Text="{DynamicResource String.ToolBar.FileTools}"
                                                      IsEnabled="{Binding CanUseCurrentFileTools}">
                            <commonControls:ToolBarButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="{DynamicResource String.FileTools.TsCheck}"
                                              Command="{Binding TsCheckClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsPacketViewer}"
                                              Command="{Binding TsPacketViewerClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource String.FileTools.RawCutter}"
                                              Command="{Binding RawCutterClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsFilterPid}"
                                              Command="{Binding TsFilterClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsFilterService}"
                                              Command="{Binding TsServiceFilterClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsEsExtractor}"
                                              Command="{Binding TsEsExtractorClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsRemux}"
                                              Command="{Binding TsRemuxClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                    <MenuItem Header="{DynamicResource String.FileTools.TsTimelineRepair}"
                                              Command="{Binding TsTimelineRepairClickCommand}"
                                              CommandParameter="{Binding VideoPath}" />
                                </MenuFlyout>
                            </commonControls:ToolBarButton.Flyout>
                        </commonControls:ToolBarButton>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ZoomFactorStr}" />
                        <commonControls:ToolBarButton ToolTip.Tip="{DynamicResource String.ToolBar.MediaInfoTip}"
                                                      LargeIcon="/Assets/file_eye.png" Classes="themed-icon"
                                                      themes:ThemeIcons.Source="{DynamicResource Icon.info}"
                                                      Text="{DynamicResource String.ToolBar.MediaInfo}"
                                                      HorizontalAlignment="Right"
                                                      Command="{Binding ShowMediaInfoClickCommand}" />
                    </commonControls:ToolBar>
                    <Grid Grid.Row="1" RowDefinitions="*, Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, 240">
                            <!-- 图片预览区域 -->
                            <ClassicBorderDecorator Grid.Column="0" Classes="app-preview-frame" BorderStyle="Etched">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Grid.Row="0" Margin="6,4"
                                                IsVisible="{Binding ShowPreviewTrackSelector}">
                                        <WrapPanel IsVisible="{Binding HasPreviewPrograms}" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,0,12,0">
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                           Text="{DynamicResource String.PreviewTrack.Program}" />
                                                <ComboBox Grid.Column="1" Width="180" MinHeight="28"
                                                          IsEnabled="{Binding CanSelectPreviewProgram}"
                                                          ItemsSource="{Binding PreviewPrograms}"
                                                          ToolTip.Tip="{Binding SelectedPreviewProgram.DisplayText}"
                                                          SelectedItem="{Binding SelectedPreviewProgram, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PreviewProgramOption">
                                                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding DisplayText}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <CheckBox IsVisible="{Binding ShowProgramExportChoice}"
                                                      IsEnabled="{Binding CanChooseProgramExport}"
                                                      IsChecked="{Binding ExportCurrentProgramOnly, Mode=TwoWay}"
                                                      Content="{DynamicResource String.PreviewTrack.ExportCurrentProgramOnly}"
                                                      ToolTip.Tip="{DynamicResource String.PreviewTrack.ExportTip}" />
                                        </WrapPanel>
                                        <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
                                            <UniformGrid Rows="1">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,0,12,0">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Text="{DynamicResource String.PreviewTrack.Video}" />
                                                    <ComboBox Grid.Column="1" MinHeight="28" HorizontalAlignment="Stretch"
                                                              IsEnabled="{Binding CanSelectPreviewVideo}"
                                                              ItemsSource="{Binding PreviewVideoTracks}"
                                                              ToolTip.Tip="{Binding SelectedPreviewVideoTrack.DisplayText}"
                                                              SelectedItem="{Binding SelectedPreviewVideoTrack, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:PreviewVideoTrackOption">
                                                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding DisplayText}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"
                                                      IsVisible="{Binding HasPreviewSubtitles}">
                                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource String.SubtitlePreview.Label}"
                                                               ToolTip.Tip="{DynamicResource String.SubtitlePreview.Tip}" />
                                                    <ComboBox Grid.Column="1" MinHeight="28" HorizontalAlignment="Stretch"
                                                              IsEnabled="{Binding CanSelectPreviewSubtitle}"
                                                              ItemsSource="{Binding PreviewSubtitleTracks}"
                                                              SelectedItem="{Binding SelectedPreviewSubtitleTrack, Mode=TwoWay}"
                                                              ToolTip.Tip="{Binding SelectedPreviewSubtitleTrack.DisplayText}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:PreviewSubtitleTrackOption">
                                                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding DisplayText}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <ProgressBar Grid.Column="1" Height="2" MinHeight="0" VerticalAlignment="Bottom"
                                                                 BorderThickness="0" Padding="0" ClipToBounds="True"
                                                                 IsIndeterminate="True" IsVisible="{Binding IsSubtitleLoading}"
                                                                 ToolTip.Tip="{DynamicResource String.SubtitlePreview.Loading}" />
                                                </Grid>
                                            </UniformGrid>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding SelectedPreviewProgram.AudioDescription}">
                                                <Run Text="{DynamicResource String.PreviewTrack.Audio}" />
                                                <Run Text="{Binding SelectedPreviewProgram.AudioDescription}" />
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                    <controls:ImageViewer Grid.Row="1" Name="ImageViewer"
                                                          IsEnabled="{Binding IsVideoInitialized}"
                                                          MaxZoomFactor="{Binding MaxZoomFactor}"
                                                          MinZoomFactor="{Binding MinZoomFactor}"
                                                          OffsetX="{Binding OffsetX, Mode=TwoWay}"
                                                          OffsetY="{Binding OffsetY, Mode=TwoWay}"
                                                          ShowNavigator="{Binding ViewerPreferences.ShowImageNavigator}"
                                                          Image="{Binding DecodedBitmap}"
                                                          GpuFrame="{Binding DecodedGpuFrame}"
                                                          SourcePixelSize="{Binding DecodedFrameSourceSize}"
                                                          SubtitleOverlay="{Binding SubtitleOverlay}"
                                                          Zoom="{Binding ZoomFactor, Mode=TwoWay}">
                                    </controls:ImageViewer>
                                    <Border Grid.Row="1" IsVisible="{Binding IsToolsOnly}"
                                            Background="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}"
                                            Padding="24">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding ToolsOnlyMessage}"
                                                       Foreground="{DynamicResource {x:Static commonControls:SystemColors.ControlTextBrushKey}}"
                                                       TextWrapping="Wrap" MaxWidth="480"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </ClassicBorderDecorator>
                            <GridSplitter Grid.Column="1" Width="3" />
                            <ClassicBorderDecorator Grid.Column="2" Classes="app-section-frame app-sidebar-frame" BorderStyle="Sunken">
                                <DockPanel>
                                    <!-- TabControl：片段列表和导出队列 -->
                                    <TabControl Name="RightTabControl">
                                        <!-- 片段列表 Tab -->
                                        <TabItem>
                                            <TabItem.Header>
                                                <TextBlock>
                                                    <Run Text="{DynamicResource String.Clips}" />
                                                </TextBlock>
                                            </TabItem.Header>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0" IsVisible="{Binding IsRemuxExport}">
                                                    <TextBlock Text="{DynamicResource String.RemuxExport.Notice}" TextWrapping="Wrap" FontSize="11" />
                                                    <Button Content="{DynamicResource String.RemuxExport.Options}" Command="{Binding RemuxExportOptionsCommand}" />
                                                </StackPanel>
                                                <Grid DockPanel.Dock="Bottom"
                                                      ColumnDefinitions="*,*"
                                                      ColumnSpacing="4"
                                                      Margin="0,2,0,0">
                                                    <Button Grid.Column="0"
                                                            Command="{Binding SelectAllClipsCommand}"
                                                            ToolTip.Tip="{DynamicResource String.Clips.SelectAllTip}">
                                                        <TextBlock Text="{DynamicResource String.Clips.SelectAll}" />
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding ExportAllCommand}"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="{DynamicResource String.ExportAllTip}">
                                                        <TextBlock Text="{DynamicResource String.ExportAll}" />
                                                    </Button>
                                                </Grid>
                                                <Grid>
                                                    <!-- Empty state -->
                                                    <TextBlock Text="{DynamicResource String.Clips.Empty}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                               IsVisible="{Binding Clips.Count, Converter={x:Static converters:ZeroToVisibilityConverter.Instance}}" />
                                                    <!-- Cards -->
                                                    <ScrollViewer Name="ClipsScrollViewer"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  IsVisible="{Binding Clips.Count, Converter={x:Static converters:PositiveToVisibilityConverter.Instance}}">
                                                        <ItemsControl ItemsSource="{Binding Clips}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,4"
                                                                        Padding="6"
                                                                        Classes.selected="{Binding IsSelected}"
                                                                        PointerPressed="ClipCard_OnPointerPressed">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                        </Style>
                                                                        <Style Selector="Border.selected">
                                                                            <Setter Property="Background" Value="{DynamicResource ClipSelectionBackgroundBrush}" />
                                                                        </Style>
                                                                    </Border.Styles>
                                                                    <Grid>
                                                                        <!-- Inactive: Raised border -->
                                                                        <ClassicBorderDecorator Classes="app-item-frame" BorderStyle="Raised"
                                                                                                IsVisible="{Binding IsActive, Converter={x:Static local:App.InverseBoolConverter}}" />
                                                                        <!-- Active editor: Sunken border -->
                                                                        <ClassicBorderDecorator Classes="app-item-frame" BorderStyle="Sunken"
                                                                                                IsVisible="{Binding IsActive}" />
                                                                        <!-- Content -->
                                                                        <Grid Margin="4"
                                                                              RowDefinitions="Auto,64,Auto,Auto"
                                                                              ColumnDefinitions="*,8,*">
                                                                            <Grid Grid.Row="0" Grid.ColumnSpan="3"
                                                                                  RowDefinitions="Auto,Auto" ColumnDefinitions="6,*,Auto,Auto" ColumnSpacing="6">
                                                                                <Border Background="{Binding LabelBrush}" IsVisible="{Binding HasColor}" Height="12" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" MaxLines="1" ToolTip.Tip="{Binding DisplayName}" FontWeight="Bold" FontSize="12"
                                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                                <Button Grid.Column="2" Theme="{StaticResource ClipEditButtonTheme}" Classes="desktop-template-button"
                                                                                        AutomationProperties.Name="{DynamicResource String.ClipDetails.Edit}"
                                                                                        Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).EditClipDetailsCommand}"
                                                                                        CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource String.ClipDetails.Edit}" />
                                                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" IsVisible="{Binding HasExportStatus}" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Notes}" MaxLines="1"
                                                                                           IsVisible="{Binding HasNotes}" TextTrimming="CharacterEllipsis" MaxHeight="20"
                                                                                           Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,2,0,3">
                                                                                    <ToolTip.Tip>
                                                                                        <TextBlock Text="{Binding Notes}" MaxWidth="320" TextWrapping="Wrap" MaxLines="8" TextTrimming="CharacterEllipsis" />
                                                                                    </ToolTip.Tip>
                                                                                </TextBlock>
                                                                            </Grid>
                                                                            <Button Grid.Row="1" Grid.Column="0" Padding="2"
                                                                                    MinWidth="0"
                                                                                    HorizontalContentAlignment="Stretch"
                                                                                    VerticalContentAlignment="Stretch"
                                                                                    IsEnabled="{Binding HasStartThumbnail}"
                                                                                    Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).JumpToStartTimeCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <Grid Background="{DynamicResource ClipThumbnailBackgroundBrush}"
                                                                                      ClipToBounds="True">
                                                                                    <Image Source="{Binding StartThumbnail}"
                                                                                           Stretch="Uniform" />
                                                                                    <TextBlock Text="—"
                                                                                               IsVisible="{Binding HasStartThumbnail, Converter={x:Static local:App.InverseBoolConverter}}"
                                                                                               Foreground="{DynamicResource ClipThumbnailPlaceholderBrush}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </Button>
                                                                            <Button Grid.Row="1" Grid.Column="2" Padding="2"
                                                                                    MinWidth="0"
                                                                                    HorizontalContentAlignment="Stretch"
                                                                                    VerticalContentAlignment="Stretch"
                                                                                    IsEnabled="{Binding HasEndThumbnail}"
                                                                                    Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).JumpToEndTimeCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <Grid Background="{DynamicResource ClipThumbnailBackgroundBrush}"
                                                                                      ClipToBounds="True">
                                                                                    <Image Source="{Binding EndThumbnail}"
                                                                                           Stretch="Uniform" />
                                                                                    <TextBlock Text="—"
                                                                                               IsVisible="{Binding HasEndThumbnail, Converter={x:Static local:App.InverseBoolConverter}}"
                                                                                               Foreground="{DynamicResource ClipThumbnailPlaceholderBrush}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </Button>

                                                                            <Button Grid.Row="2" Grid.Column="0"
                                                                                    Content="{Binding StartBoundaryTimeStr}"
                                                                                    Classes="hyperlink"
                                                                                    HorizontalAlignment="Center"
                                                                                    IsEnabled="{Binding HasStartThumbnail}"
                                                                                    Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).JumpToStartTimeCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button Grid.Row="2" Grid.Column="2"
                                                                                    Content="{Binding EndBoundaryTimeStr}"
                                                                                    Classes="hyperlink"
                                                                                    HorizontalAlignment="Center"
                                                                                    IsEnabled="{Binding HasEndThumbnail}"
                                                                                    Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).JumpToEndTimeCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <!-- Size + Output Path -->
                                                                            <Grid Grid.Row="3" Grid.ColumnSpan="3"
                                                                                  ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding EstimatedSizeStr}"
                                                                                           IsVisible="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).ShowRawClipSizeEstimate}"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0" />
                                                                                <TextBlock Text="{Binding ExportSizeStr}"
                                                                                           IsVisible="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).IsProgramExportFiltered}"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0" />
                                                                                <Button Grid.Column="1"
                                                                                        Content="{Binding OutputFilePathStr}"
                                                                                        Classes="hyperlink"
                                                                                        HorizontalContentAlignment="Stretch"
                                                                                        IsVisible="{Binding OutputFileInfo, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                                                                                        Command="{Binding #CutterMainWindow.((vm:MainWindowViewModel)DataContext).FindFileCommand}"
                                                                                        CommandParameter="{Binding OutputFileInfo}" />
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </DockPanel>
                                        </TabItem>
                                        <!-- 导出队列 Tab -->
                                        <TabItem>
                                            <TabItem.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{DynamicResource String.ExportQueue}" />
                                                    <Border CornerRadius="8"
                                                            Padding="4,1"
                                                            MinWidth="18"
                                                            HorizontalAlignment="Center"
                                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                            BorderThickness="1"
                                                            IsVisible="{Binding HasExportQueue}">
                                                        <TextBlock FontSize="10"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Text="{Binding ExportQueueCount}" />
                                                    </Border>
                                                </StackPanel>
                                            </TabItem.Header>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0">
                                                    <TextBlock Text="{DynamicResource String.RemuxExport.Notice}" TextWrapping="Wrap"
                                                               FontSize="11" IsVisible="{Binding HasRemuxQueue}" />
                                                    <Button Content="{DynamicResource String.RemuxExport.MergeQueue}" Command="{Binding MergeRemuxQueueCommand}" IsVisible="{Binding HasRemuxQueue}" />
                                                </StackPanel>
                                                <!-- 底部按钮 -->
                                                <Grid DockPanel.Dock="Bottom"
                                                      ColumnDefinitions="*,*"
                                                      ColumnSpacing="4"
                                                      Margin="0,2,0,0">
                                                    <Grid.Styles>
                                                        <Style Selector="Button:disabled Image">
                                                            <Setter Property="Opacity" Value="0.3" />
                                                        </Style>
                                                    </Grid.Styles>
                                                    <Button Grid.Column="0"
                                                            Command="{Binding ClearQueueCommand}">
                                                        <TextBlock Text="{DynamicResource String.ClearQueue}" />
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding BatchExportQueueCommand}"
                                                            Classes="accent">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Image Classes="theme-icon" Height="16" Source="{DynamicResource Icon.save}" />
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Text="{DynamicResource String.BatchExportQueue}"
                                                                       Margin="4,0,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <Grid>
                                                    <!-- Empty state -->
                                                    <TextBlock Text="{DynamicResource String.QueueEmpty}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                               IsVisible="{Binding HasExportQueue, Converter={x:Static local:App.InverseBoolConverter}}" />
                                                    <!-- Queue cards -->
                                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                                  IsVisible="{Binding HasExportQueue}">
                                                        <ItemsControl ItemsSource="{Binding ExportQueue}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ExportQueueItem">
                                                                <Border Margin="0,0,0,4"
                                                                        Padding="6">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                        </Style>
                                                                    </Border.Styles>
                                                                    <Grid>
                                                                        <ClassicBorderDecorator Classes="app-item-frame" BorderStyle="Raised" />
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                        <StackPanel Grid.Column="0" Margin="4" Spacing="2">
                                                                            <Grid ColumnDefinitions="6,*" ColumnSpacing="6">
                                                                                <Border Background="{Binding LabelBrush}" IsVisible="{Binding HasColor}" Height="12" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" MaxLines="1" ToolTip.Tip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="Bold" FontSize="12" />
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding Notes}" MaxLines="1" IsVisible="{Binding HasNotes}" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{DynamicResource AppSecondaryTextBrush}" MaxHeight="20">
                                                                                <ToolTip.Tip>
                                                                                    <TextBlock Text="{Binding Notes}" MaxWidth="320" TextWrapping="Wrap" MaxLines="8" TextTrimming="CharacterEllipsis" />
                                                                                </ToolTip.Tip>
                                                                            </TextBlock>
                                                                            <!-- Boundary times -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding StartBoundaryTimeStr}" />
                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding EndBoundaryTimeStr}" />
                                                                            </Grid>
                                                                            <!-- Size + Output path -->
                                                                            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding EstimatedSizeStr}"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0" />
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding OutputFilePathStr}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        <!-- 关闭按钮 × -->
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="×"
                                                                                   FontSize="14"
                                                                                   VerticalAlignment="Top"
                                                                                   Margin="0,2,4,0"
                                                                                   Cursor="Hand"
                                                                                   PointerPressed="QueueRemove_OnPointerPressed"
                                                                                   ToolTip.Tip="{DynamicResource String.QueueRemove}" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </DockPanel>
                                        </TabItem>
                                    </TabControl>
                                </DockPanel>
                            </ClassicBorderDecorator>
                        </Grid>
                        <!-- 时间刻度、剪辑范围、播放头、总览与缩放共用同一套坐标换算。 -->
                        <controls:TimelineControl Grid.Row="1"
                                                  Name="MainTimeline"
                                                  IsEnabled="{Binding IsVideoInitialized}"
                                                  Focusable="True"
                                                  Height="48"
                                                  Margin="0,2"
                                                  HorizontalAlignment="Stretch"
                                                  Minimum="0"
                                                  Maximum="{Binding DurationMax}"
                                                  Value="{Binding CurrentTime}"
                                                  ViewportStart="{Binding TimelineViewport.ViewStart}"
                                                  ViewportEnd="{Binding TimelineViewport.ViewEnd}"
                                                  ZoomLevel="{Binding TimelineViewport.ZoomLevel}"
                                                  Ranges="{Binding SelectedClipRanges}"
                                                  ScrubStarted="Timeline_OnScrubStarted"
                                                  ScrubPreviewRequested="Timeline_OnScrubPreviewRequested"
                                                  ScrubCanceled="Timeline_OnScrubCanceled"
                                                  SeekRequested="Timeline_OnSeekRequested"
                                                  PanRequested="Timeline_OnPanRequested"
                                                  ZoomRequested="Timeline_OnZoomRequested"
                                                  FitRequested="Timeline_OnFitRequested"
                                                  BackgroundBrush="{DynamicResource {x:Static commonControls:SystemColors.ControlColorKey}}"
                                                  TextBrush="{DynamicResource {x:Static commonControls:SystemColors.WindowTextColorKey}}"
                                                  MutedTextBrush="{DynamicResource {x:Static commonControls:SystemColors.GrayTextColorKey}}"
                                                  ClipBrush="{DynamicResource AppStatusSuccessForegroundBrush}"
                                                  AccentBrush="{DynamicResource AppRepairMapSelectionBrush}"
                                                  ViewportBrush="{DynamicResource AppRepairMapSelectionBrush}"
                                                  FitTip="{DynamicResource String.Timeline.FitTip}"
                                                  ZoomTip="{DynamicResource String.Timeline.ZoomTip}"
                                                  ScrollTip="{DynamicResource String.Timeline.ScrollTip}" />
                        <!-- 导航等控制键的一行 -->
                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto, *" Margin="0,2,0,0"
                              IsEnabled="{Binding IsVideoInitialized}">
                            <Grid.Styles>
                                <Style Selector="Button.LeftBtn">
                                    <Setter Property="Width" Value="30" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style Selector="Button.CenterBtn">
                                    <Setter Property="MinWidth" Value="30" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="4,6" />
                                </Style>
                            </Grid.Styles>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="4, 4">
                                <Button Command="{Binding MarkClipStartCommand}"
                                        Classes="LeftBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.MarkStart}">
                                    [
                                </Button>
                                <Button Command="{Binding MarkClipEndCommand}"
                                        Classes="LeftBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.MarkEnd}">
                                    ]
                                </Button>
                                <Button Command="{Binding AddClipCommand}"
                                        Classes="LeftBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.AddClip}">
                                    +
                                </Button>
                                <Button Command="{Binding RemoveClipCommand}"
                                        Classes="LeftBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.RemoveClip}">
                                    -
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal"
                                        Spacing="4"
                                        Margin="4, 4">
                                <!-- LEFT -->
                                <Button Command="{Binding Prev20GopClickCommand}"
                                        Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Previous20}">
                                    &lt;&lt;&lt;
                                </Button>
                                <Button Command="{Binding Prev10GopClickCommand}"
                                        Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Previous10}">
                                    &lt;&lt;
                                </Button>
                                <Button Command="{Binding PrevGopClickCommand}"
                                        Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Previous}">
                                    &lt;
                                </Button>
                                <!-- CENTER -->
                                <Button
                                    Content="{Binding CurrentTime, Converter={StaticResource SecondsConverter}}"
                                    Command="{Binding JumpToClickCommand}"
                                    ToolTip.Tip="{DynamicResource String.Navigate.JumpTo}"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    FontSize="22"
                                    Margin="4,0"
                                    Width="150"
                                    Classes="hyperlink" />
                                <!-- RIGHT -->
                                <Button Command="{Binding NextGopClickCommand}"
                                        Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Next}">
                                    &gt;
                                </Button>
                                <Button Command="{Binding Next10GopClickCommand}"
                                        Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Next10}">
                                    &gt;&gt;
                                </Button>
                                <Button Command="{Binding Next20GopClickCommand}"
                                        Classes="CenterBtn"
                                        ToolTip.Tip="{DynamicResource String.Navigate.Next20}">
                                    &gt;&gt;&gt;
                                </Button>
                            </StackPanel>
                            <Grid Grid.Column="2" ColumnDefinitions="*,Auto"
                                  ColumnSpacing="4" Margin="4, 4">
                                <Grid.Styles>
                                    <Style Selector="Button:disabled Image">
                                        <Setter Property="Opacity" Value="0.3" />
                                    </Style>
                                </Grid.Styles>
                                <!-- 摘要使用剩余空间，窗口变窄时截断文本，不挤出输出按钮。 -->
                                <Grid MaxWidth="180"
                                      Height="34"
                                      RowDefinitions="16,18"
                                      ClipToBounds="True"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right">
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding SelectedClipsSummaryStr}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding SelectedClipEstimatedSizeStr, Mode=OneWay}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Right" />
                                </Grid>
                                <!-- 单选保存、多选合并；保持精简文案，沿用原按钮的自适应宽度。 -->
                                <Button Grid.Column="1" Command="{Binding ClipOutputCommand}"
                                        Classes="accent"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="{Binding ClipOutputToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Classes="theme-icon" Height="16" Source="{DynamicResource Icon.save}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding ClipOutputText}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ClassicBorderDecorator>
        </DockPanel>
        <Grid Grid.RowSpan="2"
              ZIndex="99"
              IsVisible="{Binding IsDecoding}"
              Background="Transparent" />
    </Grid>
</Window>
