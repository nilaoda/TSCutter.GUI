<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TSCutter.GUI.ViewModels.Media"
             x:Class="TSCutter.GUI.Views.Media.AudioOutputListView"
             x:DataType="vm:AudioOutputList">
    <!-- 输出表格：杜比 E 与多轨合并共用。来源列只在杜比 E（按声道组输出）时显示。 -->
    <StackPanel Spacing="6" IsEnabled="{Binding IsActive}">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource String.AudioOutput.Outputs}" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" MinWidth="80" Command="{Binding AddRowCommand}"
                    Content="{DynamicResource String.AudioOutput.AddOutput}" />
        </Grid>
        <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderMidBrush}">
            <StackPanel>
                <Grid ColumnDefinitions="30,Auto,92,170,112,64,*" Margin="4,4,4,2">
                    <TextBlock Grid.Column="1" Width="160" Text="{Binding SourceHeader}" Opacity="0.75"
                               IsVisible="{Binding ShowSourceColumn}" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource String.AudioOutput.Column.Codec}" Opacity="0.75" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource String.AudioOutput.Column.Channels}" Opacity="0.75" />
                    <TextBlock Grid.Column="4" Text="{DynamicResource String.AudioOutput.Column.Bitrate}" Opacity="0.75" />
                    <TextBlock Grid.Column="5" Text="{DynamicResource String.AudioOutput.Column.Language}" Opacity="0.75" />
                </Grid>
                <ScrollViewer MaxHeight="210" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AudioOutputRow">
                                <Grid ColumnDefinitions="30,Auto,92,170,112,64,*" Margin="4,2">
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" MinWidth="0"
                                              VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="154" Margin="0,0,6,0" MinHeight="26"
                                              IsVisible="{Binding ShowSource}" IsEnabled="{Binding Enabled}"
                                              ItemsSource="{Binding Sources}"
                                              SelectedItem="{Binding SelectedSource, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="2" Margin="0,0,6,0" MinHeight="26" HorizontalAlignment="Stretch"
                                              IsEnabled="{Binding Enabled}"
                                              ItemsSource="{Binding Codecs}"
                                              SelectedItem="{Binding SelectedCodec, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="3" Margin="0,0,6,0" MinHeight="26" HorizontalAlignment="Stretch"
                                              IsEnabled="{Binding Enabled}"
                                              ItemsSource="{Binding Layouts}"
                                              SelectedItem="{Binding SelectedLayout, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="4" Margin="0,0,6,0" MinHeight="26" HorizontalAlignment="Stretch"
                                              IsEnabled="{Binding Enabled}" IsVisible="{Binding !IsLossless}"
                                              ItemsSource="{Binding Bitrates}"
                                              SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Opacity="0.7"
                                               IsVisible="{Binding IsLossless}"
                                               Text="{DynamicResource String.AudioOutput.Lossless}" />
                                    <TextBox Grid.Column="5" Margin="0,0,6,0" MinHeight="26" MaxLength="3"
                                             IsEnabled="{Binding Enabled}"
                                             Text="{Binding Language, Mode=TwoWay}" />
                                    <Button Grid.Column="6" HorizontalAlignment="Left" MinWidth="0" Padding="8,2"
                                            Content="✕" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="{DynamicResource String.AudioOutput.RemoveOutput}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <TextBlock IsVisible="{Binding ShowNoOutputHint}" TextWrapping="Wrap" Text="{Binding NoOutputHint}" />
        <TextBlock IsVisible="{Binding ShowFlacHint}" TextWrapping="Wrap"
                   Text="{DynamicResource String.AudioOutput.FlacTsHint}" />
        <TextBlock IsVisible="{Binding ShowPcmHint}" TextWrapping="Wrap"
                   Text="{DynamicResource String.AudioOutput.PcmHint}" />
        <TextBlock IsVisible="{Binding ShowLossyLimitHint}" TextWrapping="Wrap"
                   Text="{DynamicResource String.AudioOutput.LossyLimitHint}" />
    </StackPanel>
</UserControl>
