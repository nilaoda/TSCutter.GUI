<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TSCutter.GUI.ViewModels"
        xmlns:models="clr-namespace:TSCutter.GUI.Models"
        x:Class="TSCutter.GUI.Views.FrameTemplateManagerWindow"
        x:DataType="vm:FrameTemplateManagerWindowViewModel"
        Title="{DynamicResource String.FrameSearch.LibraryTitle}"
        Width="700" Height="440" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12" RowDefinitions="*,Auto,Auto,Auto" RowSpacing="8">
        <ListBox Grid.Row="0" ItemsSource="{Binding Templates}"
                 SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:SavedFrameTile">
                    <Grid ColumnDefinitions="102,*" ColumnSpacing="10" Margin="3">
                        <Border BorderThickness="1" BorderBrush="Gray" Padding="2">
                            <Image Source="{Binding Thumbnail}" Width="96" Height="54" Stretch="Uniform" />
                        </Border>
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3"
                              VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                            <TextBlock Grid.Row="1" Text="{Binding CreatedText}" Opacity="0.7" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="1" ColumnDefinitions="92,*,76,76" RowDefinitions="Auto,Auto"
              ColumnSpacing="8" RowSpacing="6">
            <TextBlock Text="{DynamicResource String.FrameSearch.Name}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding NewNameInput, Mode=TwoWay}" />
            <Button Grid.Column="2" Grid.ColumnSpan="2"
                    Content="{DynamicResource String.FrameSearch.SaveCurrent}"
                    Command="{Binding AddCurrentCommand}" />

            <TextBlock Grid.Row="1" Text="{DynamicResource String.FrameSearch.SelectedName}"
                       VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RenameInput, Mode=TwoWay}"
                     IsEnabled="{Binding HasSelectedTemplate}" />
            <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource String.FrameSearch.Rename}"
                    Command="{Binding RenameCommand}" />
            <Button Grid.Row="1" Grid.Column="3" Content="{DynamicResource String.FrameSearch.Delete}"
                    Command="{Binding DeleteCommand}" />
        </Grid>
        <CheckBox Grid.Row="2" Content="{Binding SearchFromCurrentText}"
                  IsChecked="{Binding SearchFromCurrent, Mode=TwoWay}"
                  IsEnabled="{Binding CanSearchFromCurrent}" />
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="{DynamicResource String.FrameSearch.Search}"
                    Command="{Binding SearchCommand}" MinWidth="100" />
            <Button Grid.Column="2" Content="{DynamicResource String.Cancel}"
                    Command="{Binding CancelCommand}" MinWidth="88" />
        </Grid>
    </Grid>
</Window>
