<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TSCutter.GUI.ViewModels.Player"
        xmlns:diag="using:TSCutter.GUI.Player.Diagnostics"
        xmlns:controls="using:TSCutter.GUI.Controls"
        xmlns:themes="using:TSCutter.GUI.Themes"
        x:Class="TSCutter.GUI.Views.Player.PlaybackBenchmarkWindow"
        x:DataType="vm:PlaybackBenchmarkWindowViewModel"
        Title="{DynamicResource String.PlaybackBenchmark.Title}"
        Width="900" Height="760" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="ThroughputTemplate" x:DataType="vm:PlaybackBenchmarkRow">
            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid ColumnDefinitions="1.1*,0.85*,1.4*,1.2*" ColumnSpacing="12" MinHeight="32"
                      Classes.benchmark-unused="{Binding IsMuted}">
                    <TextBlock Text="{Binding StageText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding RoleText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock><Run Text="{Binding FpsText}" /> FPS</TextBlock>
                        <TextBlock Text="{Binding ThroughputText}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        <TextBlock Text="{Binding GpuScopeText}" IsVisible="{Binding HasGpuMeasurement}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding ConclusionText}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Classes.good="{Binding IsGood}" Classes.marginal="{Binding IsMarginal}"
                               Classes.insufficient="{Binding IsInsufficient}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Grid.benchmark-unused TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style Selector="ProgressBar.idle">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TextBlock.good">
            <Setter Property="Foreground" Value="{DynamicResource AppStatusSuccessForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.marginal">
            <Setter Property="Foreground" Value="{DynamicResource AppStatusWarningForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.insufficient">
            <Setter Property="Foreground" Value="{DynamicResource AppStatusErrorForegroundBrush}" />
        </Style>
    </Window.Styles>
    <Grid Margin="12" RowDefinitions="*,Auto,Auto" RowSpacing="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Name="SourcePathBox" Text="{Binding FilePath}" IsReadOnly="True"
                             VerticalContentAlignment="Center" ToolTip.Tip="{Binding FilePath}" />
                    <Button Grid.Column="1" Content="{DynamicResource String.PlaybackBenchmark.Browse}"
                            Command="{Binding BrowseCommand}" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="2*,*,*" ColumnSpacing="10" IsEnabled="{Binding CanEdit}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource String.PlaybackBenchmark.Track}" />
                        <ComboBox Name="TrackPicker" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="diag:PlaybackBenchmarkTrack">
                                    <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{DynamicResource String.PlaybackBenchmark.Decoder}" />
                        <ComboBox Name="DecoderPicker" ItemsSource="{Binding DecoderChoices}" SelectedItem="{Binding SelectedDecoder}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BenchmarkDecoderChoice"><TextBlock Text="{Binding DisplayText}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{DynamicResource String.PlaybackBenchmark.OutputSize}" />
                        <ComboBox Name="SizePicker" ItemsSource="{Binding SizeChoices}" SelectedItem="{Binding SelectedSize}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BenchmarkSizeChoice"><TextBlock Text="{Binding DisplayText}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,130,*,Auto" ColumnSpacing="8" IsEnabled="{Binding CanEdit}">
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource String.PlaybackBenchmark.StartPosition}" />
                    <NumericUpDown Grid.Column="1" Value="{Binding StartSeconds}" Minimum="0" Maximum="{Binding MaximumStartSeconds}"
                                   Increment="1" FormatString="F2" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource String.PlaybackBenchmark.Hint}" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontSize="12" Margin="8,0"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                    <CheckBox Name="ToneMappingCheckBox" Grid.Column="3" VerticalAlignment="Center" IsEnabled="{Binding CanToneMap}" Content="{DynamicResource String.PlaybackBenchmark.Mapping}"
                              IsChecked="{Binding ToneMapping}" />
                </Grid>
                <StackPanel Grid.Row="3" Spacing="8">
                    <Grid ColumnDefinitions="200,*" ColumnSpacing="16" Margin="0,4,0,6">
                        <ClassicBorderDecorator Classes="app-preview-frame" BorderStyle="Sunken" Height="113"
                                                VerticalAlignment="Top">
                            <Grid Background="Black">
                                <Viewbox Stretch="Uniform">
                                    <controls:ImageViewer Name="BenchmarkPreview" Image="{Binding PreviewBitmap}"
                                                          GpuFrame="{Binding PreviewGpuFrame}" SourcePixelSize="{Binding PreviewSourceSize}"
                                                          Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                                          ShowNavigator="False" IsHitTestVisible="False" />
                                </Viewbox>
                                <diag:PlaybackGpuBenchmarkControl Name="GpuBenchmarkHost" Width="1" Height="1"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </ClassicBorderDecorator>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource String.PlaybackBenchmark.Playback}" FontWeight="SemiBold" />
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Name="PlaybackRate" Text="{Binding PlaybackRow.PlaybackRateText}" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Name="PlaybackVerdict" Text="{Binding PlaybackRow.PlaybackRatingText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Classes.good="{Binding PlaybackRow.IsGood}"
                                           Classes.marginal="{Binding PlaybackRow.IsMarginal}"
                                           Classes.insufficient="{Binding PlaybackRow.IsInsufficient}" />
                            </WrapPanel>
                            <TextBlock Name="PlaybackDrops" Text="{Binding PlaybackRow.DropCountsText}" TextWrapping="Wrap"
                                       IsVisible="{Binding HasPlaybackResult}" />
                            <TextBlock Text="{DynamicResource String.PlaybackBenchmark.PlaybackScope}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                            <TextBlock Name="PlaybackPath" Text="{Binding PlaybackPathText}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Name="ResultTable" Spacing="0">
                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                            <Grid ColumnDefinitions="1.1*,0.85*,1.4*,1.2*" ColumnSpacing="12">
                                <TextBlock Text="{DynamicResource String.PlaybackBenchmark.Stage}" FontSize="12"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource String.PlaybackBenchmark.Usage}" FontSize="12"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="{DynamicResource String.PlaybackBenchmark.Metrics}" FontSize="12"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="{DynamicResource String.PlaybackBenchmark.Result}" FontSize="12"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                            </Grid>
                        </Border>
                        <ContentControl Name="DecodeThroughput" Content="{Binding DecodeRow}"
                                        ContentTemplate="{StaticResource ThroughputTemplate}" HorizontalContentAlignment="Stretch" />
                        <ContentControl Name="GpuProcessing" Content="{Binding GpuRow}"
                                        ContentTemplate="{StaticResource ThroughputTemplate}" HorizontalContentAlignment="Stretch" />
                        <ContentControl Name="CpuThroughput" Content="{Binding ConversionRow}"
                                        ContentTemplate="{StaticResource ThroughputTemplate}" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                    <Expander Name="MeasurementDetails" Header="{DynamicResource String.PlaybackBenchmark.MeasurementDetails}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="6">
                                <TextBlock Text="{DynamicResource String.PlaybackBenchmark.Decode}" />
                                <TextBlock Grid.Column="1" Text="{Binding DecodeRow.MeasurementText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <TextBlock Grid.Row="1" Text="{DynamicResource String.PlaybackBenchmark.GpuProcessing}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuRow.MeasurementText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <TextBlock Grid.Row="2" Text="{DynamicResource String.PlaybackBenchmark.Conversion}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConversionRow.MeasurementText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource String.PlaybackBenchmark.MeasurementScope}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="{Binding DiagnosisText}" IsVisible="{Binding HasPlaybackIssue}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource String.PlaybackBenchmark.ResultScope}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <!-- 保留主题要求的进度条高度；完成后仅隐藏绘制，避免底部操作区移动。 -->
        <ProgressBar Name="BenchmarkProgress" Grid.Row="1" Height="6" Classes.idle="{Binding !IsBusy}"
                     Minimum="0" Maximum="100" Value="{Binding Progress}" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="48"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Classes.insufficient="{Binding HasError}" ToolTip.Tip="{Binding StatusText}" />
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{DynamicResource String.PlaybackBenchmark.Copy}" Command="{Binding CopyCommand}"
                        IsEnabled="{Binding CanCopy}" MinWidth="90" />
                <Grid Width="110">
                    <Button Name="StartBenchmarkButton" Content="{DynamicResource String.PlaybackBenchmark.Start}" Classes="accent"
                            Command="{Binding StartCommand}" IsVisible="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
                    <Button Content="{DynamicResource String.PlaybackBenchmark.Cancel}" Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsBusy}" HorizontalAlignment="Stretch" />
                </Grid>
                <Button Content="{DynamicResource String.Window.Close}" MinWidth="80" IsCancel="True"
                        Command="{x:Static themes:WindowCommands.Close}" CommandParameter="{Binding $parent[Window]}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
