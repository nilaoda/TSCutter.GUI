<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TSCutter.GUI.ViewModels.Application"
        xmlns:converters="clr-namespace:TSCutter.GUI.Converters"
        xmlns:views="clr-namespace:TSCutter.GUI.Views.Application"
        xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        xmlns:models="clr-namespace:TSCutter.GUI.Models.Application"
        xmlns:app="using:TSCutter.GUI"
        mc:Ignorable="d"
        d:DesignWidth="380" d:DesignHeight="490"
        Width="380" Height="490"
        x:Class="TSCutter.GUI.Views.Application.SettingsWindow"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        x:DataType="viewModels:SettingsWindowViewModel"
        Title="{DynamicResource String.Settings.Title}">
    <Window.Styles>
        <!-- 主题选项数量有限，使用普通面板，避免模板切换后虚拟化缓存继续引用旧容器。 -->
        <Style Selector="ComboBox.theme-picker">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="HeaderedContentControl">
            <Setter Property="Padding" Value="10,15,10,10" />
        </Style>
    </Window.Styles>
    
    <Window.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBoolConverter" />
        <ControlTheme x:Key="ThemePickerItemTheme" TargetType="ComboBoxItem"
                      BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="16,3,6,3" />
            <!-- 禁用分组标题，鼠标和键盘只能选择真正的主题。 -->
            <Style Selector="^:disabled">
                <Setter Property="Padding" Value="6,6,6,3" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.GrayTextBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>
            <!-- 首个分组直接衔接列表外框，不再叠加分隔线。 -->
            <Style Selector="^:disabled:nth-child(1)">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ControlTheme>
    </Window.Resources>
    
    <DockPanel Margin="6">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Bottom"
                    Margin="0,6,0,0"
                    Spacing="6">
            <Button Content="{DynamicResource String.Ok}"
                    Command="{Binding OkCommand}"
                    Width="70"
                    IsDefault="True"/>
            <Button Content="{DynamicResource String.Cancel}"
                    Command="{Binding CancelCommand}"
                    Width="70"
                    IsCancel="True"/>
            <Button Content="{DynamicResource String.Apply}"
                    Command="{Binding ApplyCommand}"
                    Width="70"
                    IsCancel="True"/>
        </StackPanel>
        <TabControl SelectedIndex="0">
            <TabItem Header="{DynamicResource String.Settings.General}">
                <StackPanel Orientation="Vertical" Spacing="8">
                    <HeaderedContentControl Header="{DynamicResource String.Settings.Language}">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <CheckBox IsChecked="{Binding AutoDetectLanguage}"
                                      Content="{DynamicResource String.Settings.AutoDetectLanguage}" />
                            <Grid ColumnDefinitions="100, *" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{DynamicResource String.Settings.CurrentLanguage}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" 
                                          SelectedItem="{Binding SelectedLanguage}"
                                          IsEnabled="{Binding IsLanguageEnable}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource String.Settings.Theme}">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <Grid ColumnDefinitions="100, *" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{DynamicResource String.Settings.Theme.ThemeVariantMode}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                    <!-- 自动模式 -->
                                    <RadioButton Content="{StaticResource String.Settings.Theme.AutoDetect}"
                                                 GroupName="ThemeGroup"
                                                 IsChecked="{Binding SelectedThemeVariantMode, 
                                                     Converter={StaticResource EnumToBoolConverter}, 
                                                     ConverterParameter={x:Static models:ThemeVariantMode.Automatic}}" />
                                    <!-- 浅色模式 -->
                                    <RadioButton Content="{StaticResource String.Settings.Theme.Light}"
                                                 GroupName="ThemeGroup"
                                                 IsChecked="{Binding SelectedThemeVariantMode, 
                                                     Converter={StaticResource EnumToBoolConverter}, 
                                                     ConverterParameter={x:Static models:ThemeVariantMode.Light}}" />
                                    <!-- 深色模式 -->
                                    <RadioButton Content="{StaticResource String.Settings.Theme.Dark}"
                                                 GroupName="ThemeGroup"
                                                 IsChecked="{Binding SelectedThemeVariantMode, 
                                                     Converter={StaticResource EnumToBoolConverter}, 
                                                     ConverterParameter={x:Static models:ThemeVariantMode.Dark}}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="100, *" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{DynamicResource String.Settings.CurrentLightTheme}" />
                                <ComboBox Grid.Column="1" Classes="theme-picker" ItemsSource="{Binding ThemeOptions, Converter={x:Static views:SettingsWindow.ThemeItemsConverter}}"
                                          SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                          SelectedValueBinding="{CompiledBinding Tag, DataType={x:Type ComboBoxItem}}"
                                          ItemContainerTheme="{StaticResource ThemePickerItemTheme}" />
                            </Grid>
                            <Grid ColumnDefinitions="100, *" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{DynamicResource String.Settings.CurrentDarkTheme}" />
                                <ComboBox Grid.Column="1" Classes="theme-picker" ItemsSource="{Binding DarkThemeOptions, Converter={x:Static views:SettingsWindow.ThemeItemsConverter}}"
                                          SelectedValue="{Binding SelectedDarkTheme, Mode=TwoWay}"
                                          SelectedValueBinding="{CompiledBinding Tag, DataType={x:Type ComboBoxItem}}"
                                          ItemContainerTheme="{StaticResource ThemePickerItemTheme}" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>
                    <CheckBox IsChecked="{Binding AutoCheckForUpdates}"
                              Content="{DynamicResource String.Settings.AutoCheckForUpdates}" />
                    <CheckBox IsChecked="{Binding ShowImageNavigator}"
                              Content="{DynamicResource String.Settings.ShowImageNavigator}"
                              ToolTip.Tip="{DynamicResource String.Settings.ShowImageNavigatorTip}" />
                    <CheckBox IsChecked="{Binding ShowKeyFrameStrip}"
                              Content="{DynamicResource String.Settings.ShowKeyFrameStrip}"
                              ToolTip.Tip="{DynamicResource String.Settings.ShowKeyFrameStripTip}" />
                    <CheckBox IsChecked="{Binding PreferHardwareDecoding}"
                              IsEnabled="{Binding IsHardwareDecodingAvailable}"
                              Content="{DynamicResource String.Settings.PreferHardwareDecoding}"
                              ToolTip.Tip="{DynamicResource String.Settings.PreferHardwareDecodingTip}" />
                    <CheckBox IsChecked="{Binding EnableSdrToneMapping}"
                              Content="{DynamicResource String.Settings.EnableSdrToneMapping}"
                              ToolTip.Tip="{DynamicResource String.Settings.EnableSdrToneMappingTip}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource String.Settings.Output}">
                <StackPanel Margin="10,12" Spacing="10">
                    <TextBlock Text="{DynamicResource String.Settings.OutputTemplate}" />
                    <TextBox Text="{Binding ClipOutputTemplate}" MaxLength="240" />
                    <TextBlock Text="{DynamicResource String.Settings.OutputTemplateHint}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource String.Settings.OutputTemplatePreview}" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBox Text="{Binding OutputNamePreview}" IsReadOnly="True" IsVisible="{Binding IsOutputTemplateValid}" />
                    <TextBlock Text="{DynamicResource String.Settings.OutputTemplateInvalid}"
                               TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}"
                               IsVisible="{Binding IsOutputTemplateValid, Converter={x:Static app:App.InverseBoolConverter}}" />
                    <CheckBox IsChecked="{Binding TsCheckOnExport}"
                              Content="{DynamicResource String.Settings.TsCheckOnExport}"
                              ToolTip.Tip="{DynamicResource String.Settings.TsCheckOnExportTip}"
                              Margin="0,6,0,0" />
                    <TextBlock Text="{DynamicResource String.Settings.TsCheckOnExportHint}"
                               TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
