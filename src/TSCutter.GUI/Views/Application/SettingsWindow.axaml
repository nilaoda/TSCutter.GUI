<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TSCutter.GUI.ViewModels.Application"
        xmlns:converters="clr-namespace:TSCutter.GUI.Converters"
        xmlns:views="clr-namespace:TSCutter.GUI.Views.Application"
        xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        xmlns:models="clr-namespace:TSCutter.GUI.Models.Application"
        xmlns:app="using:TSCutter.GUI"
        mc:Ignorable="d"
        d:DesignWidth="400" d:DesignHeight="480"
        Width="400" Height="480"
        MinWidth="380" MinHeight="420"
        x:Class="TSCutter.GUI.Views.Application.SettingsWindow"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        x:DataType="viewModels:SettingsWindowViewModel"
        Title="{DynamicResource String.Settings.Title}">
    <Window.Styles>
        <!-- 本窗口的下拉框选项数量都有限，使用普通面板，避免切换主题后虚拟化缓存继续引用旧容器。 -->
        <Style Selector="ComboBox">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
            </Setter>
        </Style>
    </Window.Styles>
    
    <Window.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBoolConverter" />
        <ControlTheme x:Key="ThemePickerItemTheme" TargetType="ComboBoxItem"
                      BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="16,3,6,3" />
            <!-- 禁用分组标题，鼠标和键盘只能选择真正的主题。 -->
            <Style Selector="^:disabled">
                <Setter Property="Padding" Value="6,6,6,3" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.GrayTextBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>
            <!-- 首个分组直接衔接列表外框，不再叠加分隔线。 -->
            <Style Selector="^:disabled:nth-child(1)">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ControlTheme>
    </Window.Resources>
    
    <DockPanel Margin="6">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Bottom"
                    Margin="0,6,0,0"
                    Spacing="6">
            <Button Content="{DynamicResource String.Ok}"
                    Command="{Binding OkCommand}"
                    Width="70"
                    IsDefault="True"/>
            <Button Content="{DynamicResource String.Cancel}"
                    Command="{Binding CancelCommand}"
                    Width="70"
                    IsCancel="True"/>
            <Button Content="{DynamicResource String.Apply}"
                    Command="{Binding ApplyCommand}"
                    Width="70"/>
        </StackPanel>
        <TabControl x:Name="SettingsTabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="{DynamicResource String.Settings.General}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,12" Spacing="10">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <CheckBox IsChecked="{Binding AutoDetectLanguage}"
                                      Content="{DynamicResource String.Settings.AutoDetectLanguage}" />
                            <Grid ColumnDefinitions="100, *" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{DynamicResource String.Settings.CurrentLanguage}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          IsEnabled="{Binding IsLanguageEnable}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding AutoCheckForUpdates}"
                                  Content="{DynamicResource String.Settings.AutoCheckForUpdates}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource String.Settings.Appearance}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,12" Spacing="10">
                        <Grid ColumnDefinitions="100, *" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.Theme.ThemeVariantMode}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                <!-- 自动模式 -->
                                <RadioButton Content="{DynamicResource String.Settings.Theme.AutoDetect}"
                                             GroupName="ThemeGroup"
                                             IsChecked="{Binding SelectedThemeVariantMode,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter={x:Static models:ThemeVariantMode.Automatic}}" />
                                <!-- 浅色模式 -->
                                <RadioButton Content="{DynamicResource String.Settings.Theme.Light}"
                                             GroupName="ThemeGroup"
                                             IsChecked="{Binding SelectedThemeVariantMode,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter={x:Static models:ThemeVariantMode.Light}}" />
                                <!-- 深色模式 -->
                                <RadioButton Content="{DynamicResource String.Settings.Theme.Dark}"
                                             GroupName="ThemeGroup"
                                             IsChecked="{Binding SelectedThemeVariantMode,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter={x:Static models:ThemeVariantMode.Dark}}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="100, *" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource String.Settings.ThemePreset}" />
                            <ComboBox x:Name="ThemePresetPicker" Grid.Column="1" Classes="theme-picker"
                                      ItemsSource="{Binding ThemePresetOptions, Converter={x:Static views:SettingsWindow.ThemePresetItemsConverter}}"
                                      SelectedValue="{Binding SelectedThemePreset, Mode=TwoWay}"
                                      SelectedValueBinding="{CompiledBinding Tag, DataType={x:Type ComboBoxItem}}"
                                      ItemContainerTheme="{StaticResource ThemePickerItemTheme}" />
                        </Grid>
                        <TextBlock Text="{DynamicResource String.Settings.ThemePresetHint}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        <Grid ColumnDefinitions="100, *" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.CurrentLightTheme}" />
                            <ComboBox x:Name="LightThemePicker" Grid.Column="1" Classes="theme-picker" ItemsSource="{Binding ThemeOptions, Converter={x:Static views:SettingsWindow.ThemeItemsConverter}}"
                                      SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                      SelectedValueBinding="{CompiledBinding Tag, DataType={x:Type ComboBoxItem}}"
                                      ItemContainerTheme="{StaticResource ThemePickerItemTheme}" />
                        </Grid>
                        <Grid ColumnDefinitions="100, *" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.CurrentDarkTheme}" />
                            <ComboBox x:Name="DarkThemePicker" Grid.Column="1" Classes="theme-picker" ItemsSource="{Binding DarkThemeOptions, Converter={x:Static views:SettingsWindow.ThemeItemsConverter}}"
                                      SelectedValue="{Binding SelectedDarkTheme, Mode=TwoWay}"
                                      SelectedValueBinding="{CompiledBinding Tag, DataType={x:Type ComboBoxItem}}"
                                      ItemContainerTheme="{StaticResource ThemePickerItemTheme}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource String.Settings.Preview}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,12" Spacing="10">
                        <CheckBox IsChecked="{Binding ShowImageNavigator}"
                                  Content="{DynamicResource String.Settings.ShowImageNavigator}"
                                  ToolTip.Tip="{DynamicResource String.Settings.ShowImageNavigatorTip}" />
                        <CheckBox IsChecked="{Binding ShowKeyFrameStrip}"
                                  Content="{DynamicResource String.Settings.ShowKeyFrameStrip}"
                                  ToolTip.Tip="{DynamicResource String.Settings.ShowKeyFrameStripTip}" />
                        <!-- 选项顺序与 KeyFrameStripThumbnailSize 枚举一致；隐藏预览条时不可修改。 -->
                        <Grid ColumnDefinitions="100, *" IsEnabled="{Binding ShowKeyFrameStrip}">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.KeyFrameStripThumbnailSize}" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding KeyFrameStripThumbnailSizeIndex, Mode=TwoWay}">
                                <ToolTip.Tip>
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                               Text="{DynamicResource String.Settings.KeyFrameStripThumbnailSizeTip}" />
                                </ToolTip.Tip>
                                <ComboBoxItem Content="{DynamicResource String.Settings.KeyFrameStripThumbnailSize.Small}" />
                                <ComboBoxItem Content="{DynamicResource String.Settings.KeyFrameStripThumbnailSize.Medium}" />
                                <ComboBoxItem Content="{DynamicResource String.Settings.KeyFrameStripThumbnailSize.Large}" />
                            </ComboBox>
                        </Grid>
                        <CheckBox IsChecked="{Binding ShowAudioWaveform}"
                                  IsEnabled="{Binding ShowKeyFrameStrip}"
                                  Content="{DynamicResource String.Settings.ShowAudioWaveform}"
                                  ToolTip.Tip="{DynamicResource String.Settings.ShowAudioWaveformTip}" />
                        <CheckBox IsChecked="{Binding PreferHardwareDecoding}"
                                  IsEnabled="{Binding IsHardwareDecodingAvailable}"
                                  Content="{DynamicResource String.Settings.PreferHardwareDecoding}"
                                  ToolTip.Tip="{DynamicResource String.Settings.PreferHardwareDecodingTip}" />
                        <!-- 未勾选优先硬解（含不支持硬解的平台）或只有自动一项（macOS、Linux 或未找到显卡）时禁用。 -->
                        <Grid ColumnDefinitions="100, *" IsEnabled="{Binding PreferHardwareDecoding}">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.HardwareDecodingDevice}" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding HardwareDecodingDeviceOptions}"
                                      SelectedItem="{Binding SelectedHardwareDecodingDevice, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelectHardwareDecodingDevice}">
                                <ToolTip.Tip>
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                               Text="{DynamicResource String.Settings.HardwareDecodingDeviceTip}" />
                                </ToolTip.Tip>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:HardwareDecodingDeviceOption">
                                        <Panel>
                                            <TextBlock IsVisible="{Binding IsAutomatic}" TextTrimming="CharacterEllipsis"
                                                       Text="{DynamicResource String.Settings.HardwareDecodingDevice.Automatic}" />
                                            <TextBlock IsVisible="{Binding IsMissing}" TextTrimming="CharacterEllipsis"
                                                       Text="{DynamicResource String.Settings.HardwareDecodingDevice.Missing}" />
                                            <TextBlock IsVisible="{Binding HasName}" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                        </Panel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <CheckBox IsChecked="{Binding EnableSdrToneMapping}"
                                  Content="{DynamicResource String.Settings.EnableSdrToneMapping}"
                                  ToolTip.Tip="{DynamicResource String.Settings.EnableSdrToneMappingTip}" />
                        <!-- 鼠标滚轮：步长用下拉档位，避免数字微调框占用过多空间；档位只写数量，单位由“移动单位”决定。 -->
                        <TextBlock Text="{DynamicResource String.Settings.Shortcuts.Wheel}" FontWeight="Bold" Margin="0,6,0,0" />
                        <Grid ColumnDefinitions="100, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.Shortcuts.WheelUnit}" />
                            <!-- 选项顺序与 WheelStepUnit 枚举一致。 -->
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding WheelStepUnitIndex, Mode=TwoWay}">
                                <ToolTip.Tip>
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                               Text="{DynamicResource String.Settings.Shortcuts.WheelUnitTip}" />
                                </ToolTip.Tip>
                                <ComboBoxItem Content="{DynamicResource String.Settings.Shortcuts.WheelUnit.KeyFrame}" />
                                <ComboBoxItem Content="{DynamicResource String.Settings.Shortcuts.WheelUnit.Frame}" />
                                <ComboBoxItem Content="{DynamicResource String.Settings.Shortcuts.WheelUnit.Second}" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.Shortcuts.StripStep}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding WheelStepTexts}"
                                      SelectedIndex="{Binding WheelStepIndex, Mode=TwoWay}" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.Shortcuts.ShiftWheel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ShiftWheelStepTexts}"
                                      SelectedIndex="{Binding ShiftWheelStepIndex, Mode=TwoWay}" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.Shortcuts.PreviewWheel}" />
                            <!-- 选项顺序与 PreviewWheelAction 枚举一致。 -->
                            <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding PreviewWheelActionIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource String.Settings.Shortcuts.WheelAction.Zoom}" />
                                <ComboBoxItem Content="{DynamicResource String.Settings.Shortcuts.WheelAction.Navigate}" />
                            </ComboBox>
                            <TextBlock Grid.Row="4" VerticalAlignment="Center"
                                       Text="{DynamicResource String.Settings.Shortcuts.TimelineWheel}" />
                            <!-- 选项顺序与 TimelineWheelAction 枚举一致。 -->
                            <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding TimelineWheelActionIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource String.Settings.Shortcuts.WheelAction.None}" />
                                <ComboBoxItem Content="{DynamicResource String.Settings.Shortcuts.WheelAction.Navigate}" />
                                <ComboBoxItem Content="{DynamicResource String.Settings.Shortcuts.WheelAction.Pan}" />
                            </ComboBox>
                        </Grid>
                        <CheckBox IsChecked="{Binding ReverseWheel}"
                                  Content="{DynamicResource String.Settings.Shortcuts.ReverseWheel}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource String.Settings.Output}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,12" Spacing="10">
                        <TextBlock Text="{DynamicResource String.Settings.OutputTemplate}" />
                        <TextBox Text="{Binding ClipOutputTemplate}" MaxLength="240" />
                        <TextBlock Text="{DynamicResource String.Settings.OutputTemplateHint}" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource String.Settings.OutputTemplatePreview}" FontWeight="Bold" Margin="0,6,0,0" />
                        <TextBox Text="{Binding OutputNamePreview}" IsReadOnly="True" IsVisible="{Binding IsOutputTemplateValid}" />
                        <TextBlock Text="{DynamicResource String.Settings.OutputTemplateInvalid}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}"
                                   IsVisible="{Binding IsOutputTemplateValid, Converter={x:Static app:App.InverseBoolConverter}}" />
                        <CheckBox IsChecked="{Binding TsCheckOnExport}"
                                  Content="{DynamicResource String.Settings.TsCheckOnExport}"
                                  ToolTip.Tip="{DynamicResource String.Settings.TsCheckOnExportTip}"
                                  Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource String.Settings.TsCheckOnExportHint}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        <CheckBox IsChecked="{Binding ShowExportResult}"
                                  Content="{DynamicResource String.Settings.ShowExportResult}"
                                  Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource String.Settings.Shortcuts}">
                <!-- 只读快捷键列表占满整页；只显示当前平台的按键，鼠标操作说明随「预览」页的滚轮设置变化。 -->
                <DockPanel Margin="10,12">
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" Text="{Binding ShortcutSearchText}"
                             Watermark="{DynamicResource String.Settings.Shortcuts.Search}" />
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                               Text="{DynamicResource String.Settings.Shortcuts.ReadOnlyHint}" />
                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}"
                            Background="{DynamicResource {x:Static common:SystemColors.WindowBrushKey}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*, 110"
                                  Background="{DynamicResource {x:Static common:SystemColors.ControlBrushKey}}">
                                <TextBlock Grid.Column="0" Margin="8,3" Text="{DynamicResource String.Settings.Shortcuts.ColumnAction}" />
                                <TextBlock Grid.Column="1" Margin="8,3" Text="{DynamicResource String.Settings.Shortcuts.ColumnKeys}" />
                            </Grid>
                            <Panel>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ShortcutGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ShortcutGroup">
                                                <StackPanel>
                                                    <Border BorderThickness="0,1,0,0"
                                                            BorderBrush="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}"
                                                            Background="{DynamicResource {x:Static common:SystemColors.ControlBrushKey}}">
                                                        <TextBlock Margin="8,3" FontWeight="Bold" Text="{Binding Title}" />
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding Entries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ShortcutEntry">
                                                                <Grid ColumnDefinitions="*, 110">
                                                                    <TextBlock Grid.Column="0" Margin="8,3" TextWrapping="Wrap" Text="{Binding Action}" />
                                                                    <TextBlock Grid.Column="1" Margin="8,3" TextWrapping="Wrap" Text="{Binding Keys}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Margin="8" HorizontalAlignment="Center" VerticalAlignment="Top"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                           IsVisible="{Binding HasNoShortcutMatch}"
                                           Text="{DynamicResource String.Settings.Shortcuts.NoMatch}" />
                            </Panel>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
