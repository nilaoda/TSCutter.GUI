<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://TSCutterGUI/Themes/Windows11Dark.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="MacOSWindowSurfaceBrush" Color="#1E1E1E" />

    <Color x:Key="AppAccentColor">#0A84FF</Color>
    <Color x:Key="AppAccentHoverColor">#409CFF</Color>
    <Color x:Key="AppSelectionColor">#663D7FBF</Color>
    <Color x:Key="SystemAccentColor">#0A84FF</Color>
    <Color x:Key="DesktopFocusBorderColor">#0A84FF</Color>
    <SolidColorBrush x:Key="Windows11BackdropTintBrush" Color="#661C1C1E" />
</ResourceDictionary>
