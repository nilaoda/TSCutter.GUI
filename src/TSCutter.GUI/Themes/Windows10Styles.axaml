<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
        xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        xmlns:local="using:TSCutter.GUI.Themes">
    <Styles.Resources>
        <ControlTemplate x:Key="Windows10TitleTemplate" TargetType="TemplatedControl">
            <Panel>
                <Border Name="PART_GradientBar" IsHitTestVisible="False" />
                <!-- 标题靠左并为窗口按钮预留空间，拖动和双击由共用标题栏处理器接管。 -->
                <DockPanel ClipToBounds="True">
                    <local:DesktopCaptionButtons Name="PART_CaptionButtons" DockPanel.Dock="Right" />
                    <local:DesktopWindowIcon Icon="{Binding $parent[Window].Icon}"
                                             SmallIcon="{Binding (classic:ClassicWindow.SmallIcon), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                                             Width="16" Height="16" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Name="Windows10Title" Text="{Binding $parent[Window].Title}" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource {x:Static common:NonClientMetrics.CaptionFontKey}}"
                               FontSize="{DynamicResource {x:Static common:NonClientMetrics.CaptionFontSizeKey}}"
                               Foreground="{DynamicResource {x:Static common:SystemColors.ActiveCaptionTextBrushKey}}"
                               Margin="5,0,5,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </DockPanel>
            </Panel>
        </ControlTemplate>
        <!-- 使用几何图形绘制细线图标，不依赖系统图标字体。 -->
        <DataTemplate x:Key="Windows10MinimizeGlyph">
            <Path Width="10" Height="10" Margin="0" Stretch="None" Data="M0,5 H10 V6 H0 Z"
                  Fill="{Binding $parent[Button].Foreground}" />
        </DataTemplate>
        <DataTemplate x:Key="Windows10MaximizeGlyph">
            <Path Width="10" Height="10" Margin="0" Stretch="None" Data="F0 M0,0 H10 V10 H0 Z M1,1 V9 H9 V1 Z"
                  Fill="{Binding $parent[Button].Foreground}" />
        </DataTemplate>
        <DataTemplate x:Key="Windows10RestoreGlyph">
            <Path Width="10" Height="10" Margin="0" Stretch="None"
                  Data="F0 M2,0 H10 V8 H8 V10 H0 V2 H2 Z M3,1 V2 H8 V7 H9 V1 Z M1,3 V9 H7 V3 Z"
                  Fill="{Binding $parent[Button].Foreground}" />
        </DataTemplate>
        <DataTemplate x:Key="Windows10CloseGlyph">
            <Path Width="10" Height="10" Margin="0" Stretch="None" Data="M0,0 L10,10 M0,10 L10,0" StrokeThickness="1"
                  Stroke="{Binding $parent[Button].Foreground}" />
        </DataTemplate>
    </Styles.Resources>
    <Style Selector=":is(classic|ClassicWindow).desktop-theme.modern-caption">
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl)">
            <Setter Property="Template" Value="{StaticResource Windows10TitleTemplate}" />
        </Style>
        <Style Selector="^[IsActive=False] /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ TextBlock#Windows10Title">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.InactiveCaptionTextBrushKey}}" />
        </Style>
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button">
            <Setter Property="Template" Value="{StaticResource FlatCaptionButtonTemplate}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_MinimizeButton">
            <Setter Property="ContentTemplate" Value="{StaticResource Windows10MinimizeGlyph}" />
        </Style>
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_RestoreButton">
            <Setter Property="ContentTemplate" Value="{StaticResource Windows10MaximizeGlyph}" />
        </Style>
        <Style Selector="^[WindowState=Maximized] /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_RestoreButton">
            <Setter Property="ContentTemplate" Value="{StaticResource Windows10RestoreGlyph}" />
        </Style>
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_CloseButton">
            <Setter Property="ContentTemplate" Value="{StaticResource Windows10CloseGlyph}" />
        </Style>
        <Style Selector="^[IsActive=False] /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.InactiveCaptionTextBrushKey}}" />
        </Style>
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Windows10CaptionHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopCaptionGlyphBrush}" />
        </Style>
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button:pressed">
            <Setter Property="Background" Value="{DynamicResource Windows10CaptionPressedBrush}" />
        </Style>
        <Style Selector="^[IsActive=False] /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Windows10InactiveCaptionHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.InactiveCaptionTextBrushKey}}" />
        </Style>
        <Style Selector="^[IsActive=False] /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button:pressed">
            <Setter Property="Background" Value="{DynamicResource Windows10InactiveCaptionPressedBrush}" />
        </Style>
        <!-- 失焦时仍区分可用与禁用按钮；关闭按钮的红底白图标继续由交互状态接管。 -->
        <Style Selector="^.windows10[IsActive=False] /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button:not(:disabled)">
            <Setter Property="Foreground" Value="{DynamicResource Windows10InactiveCaptionGlyphBrush}" />
        </Style>
        <!-- 关闭按钮仅在悬停或按下时变红，文字同步变白，失焦窗口也遵循相同规则。 -->
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_CloseButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource Windows10CloseHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_CloseButton:pressed">
            <Setter Property="Background" Value="{DynamicResource Windows10ClosePressedBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.GrayTextBrushKey}}" />
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="^ /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_CloseButton:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.GrayTextBrushKey}}" />
        </Style>
        <!-- 禁用图标直接采用标题栏专用配色，避免灰色再乘低透明度后几乎消失。 -->
        <Style Selector="^.windows10 /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_RestoreButton:disabled, ^.windows10 /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_MinimizeButton:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Windows10DisabledCaptionGlyphBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^.windows10[IsActive=False] /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_RestoreButton:disabled, ^.windows10[IsActive=False] /template/ DockPanel#RootLayout > :is(TemplatedControl) /template/ :is(chrome|CaptionButtons) /template/ Button#PART_MinimizeButton:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Windows10InactiveDisabledCaptionGlyphBrush}" />
        </Style>
    </Style>
</Styles>
