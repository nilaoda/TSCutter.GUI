<Project>
    <PropertyGroup>
        <PublishAot>true</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>
        <SelfContained>true</SelfContained>
        <StripSymbols>true</StripSymbols>
        <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
        <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
        <IlcTrimMetadata>true</IlcTrimMetadata>
        <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
        <DebugType>None</DebugType>
        <DebuggerSupport>false</DebuggerSupport>
        <FFmpegLinkMode>Static</FFmpegLinkMode>
        <AppleMinOSVersion Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">14.0</AppleMinOSVersion>

        <!-- 流水线使用 RUNNER_TEMP；本地 SDK 默认放在 .build/static/<rid>。 -->
        <StaticSdkRoot Condition="'$(StaticSdkRoot)' == '' And '$(RUNNER_TEMP)' != ''">$(RUNNER_TEMP)</StaticSdkRoot>
        <StaticSdkRoot Condition="'$(StaticSdkRoot)' == ''">$(MSBuildProjectDirectory)/../../.build/static/$(RuntimeIdentifier)</StaticSdkRoot>
        <FFmpegStaticRoot Condition="'$(FFmpegStaticRoot)' == ''">$(StaticSdkRoot)/ffmpeg-static</FFmpegStaticRoot>
        <FFmpegStaticSupportRoot Condition="'$(FFmpegStaticSupportRoot)' == ''">$(StaticSdkRoot)/ffmpeg-static-support</FFmpegStaticSupportRoot>
        <NativeGraphicsStaticRoot Condition="'$(NativeGraphicsStaticRoot)' == ''">$(StaticSdkRoot)/graphics-static</NativeGraphicsStaticRoot>
        <NativeGraphicsSupportRoot Condition="'$(NativeGraphicsSupportRoot)' == ''">$(StaticSdkRoot)/graphics-static-support</NativeGraphicsSupportRoot>
    </PropertyGroup>
</Project>
