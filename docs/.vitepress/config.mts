// notice：页面底部的 AI 生成说明，由主题布局在文档页底部显示
function themeConfig(prefix: string, text: Strings): DefaultTheme.Config & { notice: string } {
  return {
    nav: [
      { text: text.guide, link: `${prefix}/guide/getting-started`, activeMatch: `${prefix}/guide/` },
      { text: text.download, link: releases },
      { text: text.changelog, link: `${repository}/releases` }
    ],
    sidebar: {
      [`${prefix}/guide/`]: [
        {
          text: text.guide,
          items: text.pages.map(([slug, title]) => ({ text: title, link: `${prefix}/guide/${slug}` }))
        }
      ]
    },
    footer: { message: `${text.footer} · TSCutter.GUI`, copyright: text.notice },
    notice: text.notice,
    outline: { label: text.outline, level: [2, 3] },
    docFooter: { prev: text.prev, next: text.next },
    langMenuLabel: text.language,
    darkModeSwitchLabel: text.appearance,
    sidebarMenuLabel: text.menu,
    returnToTopLabel: text.top,
    lightModeSwitchTitle: text.light,
    darkModeSwitchTitle: text.dark,
    notFound: { title: text.notFound, quote: '', linkText: text.home }
  }
}

export default defineConfig({
  base,
  title: 'TSCutter.GUI',
  cleanUrls: true,
  lastUpdated: false,
  head: [
    ['link', { rel: 'icon', type: 'image/svg+xml', href: `${base}logo.svg` }],
    // 首次访问根路径时按浏览器语言选一次语言版本；之后不再跳转，保留访问者自己的选择。
    ['script', {}, `(() => {
  try {
    const base = ${JSON.stringify(base)};
    if (localStorage.getItem('tscutter-site-visited')) return;
    localStorage.setItem('tscutter-site-visited', '1');
    const path = location.pathname;
    if (path !== base && path !== base + 'index.html') return;
    const languages = (navigator.languages || [navigator.language || '']).map(value => value.toLowerCase());
    const first = languages[0] || '';
    if (/^zh-(tw|hk|mo)|^zh-hant/.test(first)) location.replace(base + 'zh-tw/');
    else if (!first.startsWith('zh')) location.replace(base + 'en/');
  } catch {}
})();`]
